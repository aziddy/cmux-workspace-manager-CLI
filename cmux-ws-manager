def as_dict(value):
    return value if isinstance(value, dict) else {}

def as_list(value):
    return value if isinstance(value, list) else []

def as_text(value):
    return value if isinstance(value, str) and "\0" not in value else ""

def as_uuid(value):
    value = as_text(value)
    return value.lower() if re.fullmatch(UUID_PATTERN, value) else ""

def finite_number(value):
    try:
        return type(value) in (int, float) and math.isfinite(value)
    except OverflowError:
        return False

def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError, RecursionError):
        return None

def parse_jsonc(text):
    """Remove comments and trailing commas without touching quoted strings."""
    for comments in (True, False):
        out, i = [], 0
        while i < len(text):
            c = text[i]
            if c == '"':
                start, i = i, i + 1
                while i < len(text):
                    if text[i] == "\\":
                        i += 2
                    elif text[i] == '"':
                        i += 1
                        break
                    else:
                        i += 1
                out.append(text[start:i])
                continue
            if comments and text.startswith("//", i):
                end = text.find("\n", i + 2)
                i = len(text) if end < 0 else end
                out.append(" ")
                continue
            if comments and text.startswith("/*", i):
                end = text.find("*/", i + 2)
                if end < 0:
                    raise ValueError("unterminated comment")
                i = end + 2
                out.append(" ")
                continue
            if not comments and c == ",":
                next_i = i + 1
                while next_i < len(text) and text[next_i].isspace():
                    next_i += 1
                if next_i < len(text) and text[next_i] in "]}":
                    i += 1
                    continue
            out.append(c)
            i += 1
        text = "".join(out)
    def reject_constant(value):
        raise ValueError("non-finite JSON number")
    return json.loads(text.lstrip("\ufeff"), parse_constant=reject_constant)

def settings_file(path, label, notices):
    try:
        with open(path, encoding="utf-8-sig") as f:
            text = f.read(2 * 1024 * 1024 + 1)
        if len(text) > 2 * 1024 * 1024:
            raise ValueError("settings file too large")
        data = parse_jsonc(text)
        if not isinstance(data, dict):
            raise ValueError("expected settings object")
        version = data.get("schemaVersion", 1)
        if type(version) is not int or version != 1:
            notices.append(f"Unverified schema version in {label}; reading known settings only.")
        return data, "parsed"
    except FileNotFoundError:
        return {}, "missing"
    except (OSError, ValueError, RecursionError):
        notices.append(f"Could not read {label}; comparison is incomplete.")
        return {}, "invalid"

def settings_app(notices):
    """Identify the CLI's app without opening a window or needing its socket."""
    version, commit, domain, info = "", "", "com.cmuxterm.app", {}
    binary = os.path.realpath(shutil.which("cmux") or "")
    if ".app/Contents/" in binary:
        path = binary.split(".app/Contents/", 1)[0] + ".app/Contents/Info.plist"
        try:
            with open(path, "rb") as f:
                info = as_dict(plistlib.load(f))
            identifier = as_text(info.get("CFBundleIdentifier"))
            if re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9.-]*", identifier):
                domain = identifier
        except (OSError, ValueError, plistlib.InvalidFileException, ExpatError, RecursionError):
            pass
    try:
        result = subprocess.run(["cmux", "--version"], capture_output=True,
                                text=True, timeout=3)
        match = re.search(r"\bcmux (\d+\.\d+\.\d+)\b", result.stdout) if result.returncode == 0 else None
        if match:
            version = match[1]
            sha = re.search(r"\[([0-9a-f]{7,40})\]", result.stdout)
            commit = sha[1] if sha else ""
    except (OSError, subprocess.TimeoutExpired, UnicodeError):
        pass
    if not version:
        version = as_text(info.get("CFBundleShortVersionString"))
        if not re.fullmatch(r"\d+\.\d+\.\d+", version):
            version = ""
    verified = (version == SETTINGS_VERSION and
                (not commit or commit.startswith(SETTINGS_COMMIT) or SETTINGS_COMMIT.startswith(commit)))
    if not verified:
        label = version if re.fullmatch(r"\d+\.\d+\.\d+", version) else "unavailable"
        notices.append(f"cmux version {label}: defaults are verified only for {SETTINGS_VERSION} "
                       f"({SETTINGS_COMMIT}); displayed comparisons are unverified.")
    return version, domain, verified

def settings_preferences(domain, notices):
    """Export in memory; only allowlisted setting keys reach the report."""
    try:
        result = subprocess.run(["defaults", "export", domain, "-"],
                                capture_output=True, timeout=3)
        if result.returncode == 0:
            data = plistlib.loads(result.stdout)
            if not isinstance(data, dict):
                raise ValueError("expected preference dictionary")
            return data, True
        if b"does not exist" in result.stderr.lower():
            return {}, True
    except (OSError, ValueError, plistlib.InvalidFileException, ExpatError,
            RecursionError, OverflowError, subprocess.TimeoutExpired):
        pass
    path = os.path.expanduser(f"~/Library/Preferences/{domain}.plist")
    try:
        with open(path, "rb") as f:
            data = plistlib.load(f)
        if isinstance(data, dict):
            notices.append("Using the saved preference file; live macOS preferences were unavailable.")
            return data, False
    except (OSError, ValueError, plistlib.InvalidFileException, ExpatError, RecursionError, OverflowError):
        pass
    notices.append("Could not read macOS preferences; comparison is incomplete.")
    return {}, False

def setting_at(data, key):
    for part in key.split("."):
        if not isinstance(data, dict) or part not in data:
            raise KeyError(key)
        data = data[part]
    return data

def normalize_setting(key, value, preferences=False):
    default, pref, codec = SETTINGS_DEFAULTS[key]
    if codec == "inverse" and preferences and type(value) is bool:
        value = not value
    elif codec == "minimal" and preferences:
        if value not in ("standard", "minimal"):
            raise ValueError("unknown presentation mode")
        value = value == "minimal"
    elif codec == "branch" and preferences and type(value) is bool:
        value = "vertical" if value else "inline"
    elif codec == "width":
        if value is False or (preferences and finite_number(value) and value <= 0):
            return False
        if not finite_number(value) or value <= 0:
            raise ValueError("invalid width")
        if key.startswith("terminal."):
            return max(320, math.floor(value / 20 + 0.5) * 20)
        return min(4096, max(276, math.floor(value + 0.5)))
    elif codec == "color":
        if value is None or value == "":
            if default is not None:
                raise ValueError("color is not nullable")
            return None
        if not isinstance(value, str) or not re.fullmatch(r"#?[0-9a-fA-F]{6}", value.strip()):
            raise ValueError("invalid color")
        return "#" + value.strip().lstrip("#").upper()
    elif codec == "lines":
        if preferences and isinstance(value, str):
            value = value.splitlines()
        if not isinstance(value, list) or any(not isinstance(v, str) for v in value):
            raise ValueError("invalid patterns")
        return list(dict.fromkeys(v.strip() for v in value if v.strip()))
    elif codec == "json" and preferences and isinstance(value, (str, bytes)):
        value = json.loads(value or "[]")
    elif codec == "socket" and isinstance(value, str):
        modes = {"off": "off", "cmuxonly": "cmuxOnly", "notifications": "cmuxOnly",
                 "automation": "automation", "password": "password", "allowall": "allowAll",
                 "openaccess": "allowAll", "fullopenaccess": "allowAll", "full": "allowAll"}
        value = modes.get(value.replace("-", "").lower(), value)
    elif codec == "palette":
        if not isinstance(value, dict) or any(not isinstance(v, str) for v in value.values()):
            raise ValueError("invalid palette")
        normalized = {}
        for name, color in value.items():
            if not name.strip() or not re.fullmatch(r"#?[0-9a-fA-F]{6}", color.strip()):
                raise ValueError("invalid palette color")
            normalized[name.strip()] = "#" + color.strip().lstrip("#").upper()
        return normalized
    if type(default) is bool:
        valid = type(value) is bool
    elif finite_number(default):
        valid = finite_number(value) and (type(default) is not int or int(value) == value)
    else:
        valid = isinstance(value, type(default))
    if not valid:
        raise ValueError("invalid setting type")
    rules = SETTINGS_CONSTRAINTS.get(key, {})
    if "enum" in rules and value not in rules["enum"]:
        raise ValueError("unknown enum value")
    if finite_number(value):
        if value < rules.get("minimum", -math.inf) or value > rules.get("maximum", math.inf):
            raise ValueError("setting out of range")
    if rules.get("strings") and any(not isinstance(v, str) for v in value):
        raise ValueError("invalid array value")
    if isinstance(value, str):
        if not rules.get("minLength", 0) <= len(value) <= rules.get("maxLength", math.inf):
            raise ValueError("invalid string length")
        if "pattern" in rules and not re.search(rules["pattern"], value):
            raise ValueError("invalid string value")
    json.dumps(value, allow_nan=False)  # reject nested non-finite numbers and plist-only values
    return value

def normalize_shortcut(value, preferences=False):
    aliases = {"command": "cmd", "super": "cmd", "meta": "cmd", "control": "ctrl",
               "option": "alt", "opt": "alt", "return": "enter", "esc": "escape",
               "spacebar": "space", "delete": "backspace", "forwarddelete": "delete",
               "plus": "=", "equals": "=", "comma": ",", "period": ".",
               "leftarrow": "left", "rightarrow": "right", "uparrow": "up", "downarrow": "down",
               "semicolon": ";", "quote": "'", "apostrophe": "'", "backtick": "`", "grave": "`",
               "minus": "-", "hyphen": "-", "leftbracket": "[", "openbracket": "[",
               "rightbracket": "]", "closebracket": "]", "slash": "/", "backslash": "\\",
               "←": "left", "→": "right", "↑": "up", "↓": "down",
               "\r": "enter", "\t": "tab", "\x1b": "escape", "\x7f": "backspace",
               "\uf700": "up", "\uf701": "down", "\uf702": "left", "\uf703": "right"}
    def stroke(raw):
        if not isinstance(raw, str):
            raise ValueError("invalid shortcut stroke")
        parts = [aliases.get(v.lower(), v.lower()) for v in raw.strip().split("+")]
        mods, key = parts[:-1], parts[-1]
        if any(v not in ("ctrl", "alt", "shift", "cmd") for v in mods) or not key:
            raise ValueError("invalid shortcut modifiers")
        if len(key) != 1 and key not in ("enter", "tab", "escape", "space", "backspace", "delete",
                                       "up", "down", "left", "right", "home", "end", "pageup", "pagedown") \
                and not re.fullmatch(r"f(?:[1-9]|[12][0-9]|3[0-5])", key):
            raise ValueError("invalid shortcut key")
        return "+".join([v for v in ("ctrl", "alt", "shift", "cmd") if v in mods] + [key])
    if preferences:
        if isinstance(value, (str, bytes)):
            value = json.loads(value)
        if not isinstance(value, dict) or not isinstance(value.get("key"), str):
            raise ValueError("invalid saved shortcut")
        if value["key"] == "":
            return None
        strokes = []
        for prefix in ("", "chord"):
            key = value.get(prefix + "Key" if prefix else "key")
            if key is None:
                continue
            if not isinstance(key, str):
                raise ValueError("invalid saved shortcut key")
            key = aliases.get(key, "space" if key == " " else key)
            flags = [("ctrl", "control"), ("alt", "option"), ("shift", "shift"), ("cmd", "command")]
            mods = []
            for modifier, name in flags:
                if not prefix and name not in value:
                    raise ValueError("missing saved shortcut modifier")
                flag = value.get(prefix + name.title() if prefix else name, False)
                if type(flag) is not bool:
                    raise ValueError("invalid saved shortcut modifier")
                if flag:
                    mods.append(modifier)
            strokes.append(stroke("+".join(mods + [key])))
    else:
        if value is None or (isinstance(value, str) and value.strip().lower() in ("", "none", "unbound", "disabled")):
            return None
        strokes = value if isinstance(value, list) else [value]
        if not 1 <= len(strokes) <= 2:
            raise ValueError("invalid shortcut chord")
        if len(strokes) == 1 and isinstance(strokes[0], str) and strokes[0].strip().lower() in \
                ("", "none", "unbound", "disabled"):
            return None
        strokes = [stroke(v) for v in strokes]
    return strokes[0] if len(strokes) == 1 else strokes

def settings_report():
    notices, sources, configured = [], [], {}
    version, domain, verified = settings_app(notices)
    preferences, prefs_ok = settings_preferences(domain, notices)
    paths = [("~/.config/cmux/cmux.json", "cmux.json"),
             ("~/.config/cmux/settings.json", "settings.json"),
             ("~/Library/Application Support/com.cmuxterm.app/settings.json", "Application Support settings.json")]
    config_ok = True
    for index, (path, label) in enumerate(paths):
        data, state = settings_file(os.path.expanduser(path), label, notices)
        if state == "invalid":
            config_ok = False
            if index == 0:
                break  # cmux does not merge fallbacks into an invalid primary
        sources.append((data, label))
    for key in SETTINGS_DEFAULTS:
        if key in SETTINGS_PREF_ONLY:
            continue
        for data, label in sources:
            try:
                configured[key] = (normalize_setting(key, setting_at(data, key)), label)
                break
            except KeyError:
                pass
            except (ValueError, TypeError, OverflowError, RecursionError):
                notices.append(f"Invalid {key} in {label}; value skipped.")
    # Unknown keys in settings sections deserve a notice; shared-file commands,
    # actions, credentials and layout definitions never enter the report.
    supported = set(SETTINGS_DEFAULTS) - SETTINGS_PREF_ONLY
    supported |= {"shortcuts.bindings", "shortcuts.when", "automation.socketPassword", "workspaceGroups.byCwd"}
    def unknown_keys(path, value):
        if path in supported:
            return []
        if isinstance(value, dict) and any(k.startswith(path + ".") for k in supported):
            return [k for name, child in value.items() for k in unknown_keys(path + "." + name, child)]
        return [path]
    for data, label in sources:
        unknown = [key for section, value in data.items()
                   if any(k.startswith(section + ".") for k in supported)
                   for key in unknown_keys(section, value)]
        if unknown:
            names = ", ".join(sanitize(key)[:80] for key in unknown[:5])
            notices.append(f"Unsupported settings in {label}: {names}" + (" ..." if len(unknown) > 5 else ""))
    imported = preferences.get("cmux.settingsFile.importedManagedDefaults.v1", b"{}")
    try:
        imported = as_dict(json.loads(imported)) if isinstance(imported, (str, bytes)) else {}
    except (ValueError, RecursionError):
        imported = {}
    items, checked = [], 0
    def add(key, current, default, source, known):
        if not known or current != default:
            items.append({"setting": key, "current": current, "default": default,
                          "source": source, "verified": known})
    for key, (default, pref, codec) in SETTINGS_DEFAULTS.items():
        current, source, present = default, "factory default", False
        if key in configured:
            current, source = configured[key]
            present = True
        if pref in preferences:
            try:
                current = normalize_setting(key, preferences[pref], preferences=True)
                source, present = "macOS preferences", True
            except (ValueError, TypeError, OverflowError, RecursionError):
                notices.append(f"Invalid {key} in macOS preferences; value skipped.")
                continue
        elif codec in ("color", "palette") and pref in imported and current != default:
            current, source, present = default, "macOS preferences (cleared)", True
        if key == "app.confirmQuit" and pref not in preferences and "warnBeforeQuitShortcut" in preferences:
            legacy = preferences["warnBeforeQuitShortcut"]
            if type(legacy) is bool:
                current, source, present = "always" if legacy else "never", "macOS preferences (legacy)", True
        known = verified and (prefs_ok if pref else config_ok)
        checked += int(known)
        if present:
            add(key, current, default, source, known)
    bindings, contexts = {}, {}
    for data, label in reversed(sources):
        section = data.get("shortcuts", {})
        if not isinstance(section, dict):
            continue
        for name, target in (("bindings", bindings), ("when", contexts)):
            values = section.get(name, {})
            if isinstance(values, dict):
                target.update({action: (value, label) for action, value in values.items()})
            else:
                notices.append(f"Invalid shortcuts.{name} in {label}; values skipped.")
    for action in sorted(set(SHORTCUT_DEFAULTS) | SHORTCUT_DYNAMIC | set(bindings)):
        pref = "shortcut." + action
        if action not in SHORTCUT_DEFAULTS and action not in SHORTCUT_DYNAMIC:
            notices.append(f"Unsupported shortcut action: {sanitize(action)[:80]}.")
            continue
        known = verified and action in SHORTCUT_DEFAULTS and (config_ok if action in bindings else prefs_ok)
        checked += int(known)
        default = SHORTCUT_DEFAULTS.get(action)
        try:
            if action in bindings:  # cmux's file-managed shortcut bindings outrank preferences
                value, source = bindings[action]
                current = normalize_shortcut(value)
            elif pref in preferences:
                current = normalize_shortcut(preferences[pref], preferences=True)
                source = "macOS preferences"
            else:
                continue
            add("shortcuts.bindings." + action, current, default, source, known)
        except (ValueError, TypeError, RecursionError):
            notices.append(f"Invalid shortcut binding for {action}; value skipped.")
    for action, (value, source) in sorted(contexts.items()):
        if action in SHORTCUT_DEFAULTS or action in SHORTCUT_DYNAMIC:
            if isinstance(value, str):
                add("shortcuts.when." + action, value, None, source, False)
            else:
                notices.append(f"Invalid shortcut context for {action}; value skipped.")
        else:
            notices.append(f"Unsupported shortcut context action: {sanitize(action)[:80]}.")
    items.sort(key=lambda item: item["setting"])
    changed = sum(it["verified"] for it in items)
    unverified = len(items) - changed
    if unverified and verified:
        notices.append("Some comparisons are unverified: their defaults depend on shortcut context "
                       "or their current preferences were unavailable.")
    notices = list(dict.fromkeys(notices))
    return {"items": items, "version": version, "baseline": SETTINGS_VERSION, "checked": checked,
            "changed": changed, "unverified": unverified, "notices": notices,
            "complete": verified and not notices}

def setting_value(item, default=False):
    if default and not item["verified"]:
        return "(unverified)"
    value = item["default" if default else "current"]
    if value is None and item["setting"].startswith("shortcuts.bindings."):
        return "(unbound)"
    return json.dumps(value, ensure_ascii=False, sort_keys=True, allow_nan=False)

def settings_summary(report):
    version = report["version"] or "unavailable"
    return (f"cmux {version}: {report['changed']} changed, {report['unverified']} unverified, "
            f"{report['checked']} settings checked")

def print_settings(report):
    print(settings_summary(report))
    rows = [("Setting", "Current", "Default", "Source")] + [
        (it["setting"], setting_value(it), setting_value(it, True), it["source"])
        for it in report["items"]]
    rows = [tuple(sanitize(value) for value in row) for row in rows]
    widths = [max(dwidth(row[column]) for row in rows) for column in range(3)]
    if report["items"]:
        for row in rows:
            print("  ".join([pad(row[i], widths[i]) for i in range(3)] + [row[3]]))
    elif report["checked"]:
        print(f"No differences among {report['checked']} verified settings.")
    else:
        print("No settings could be verified.")
    for notice in report["notices"]:
        sys.stderr.write("Settings: " + sanitize(notice) + "\n")

def remember_group(catalog, group_id, name, ts):
    group_id, name = as_uuid(group_id), as_text(name).strip()
    ts = ts if finite_number(ts) else 0
    if group_id and name and ts >= catalog["groups"].get(group_id, {}).get("ts", 0):
        catalog["groups"][group_id] = {"name": name, "ts": ts}

def load_group_catalog():
    catalog = {"version": 1, "groups": {}, "aliases": {}}
    data = as_dict(read_json(GROUPS))
    if type(data.get("version")) is not int or data["version"] != 1:
        return catalog
    for group_id, info in as_dict(data.get("groups")).items():
        info = as_dict(info)
        remember_group(catalog, group_id, info.get("name"), info.get("ts"))
    for source, target in as_dict(data.get("aliases")).items():
        source, target = as_uuid(source), as_uuid(target)
        if source and target and source != target:
            catalog["aliases"][source] = target
    return catalog

def save_group_catalog(catalog, save_aliases=True):
    """Atomically store names and recreated identities, never session payloads."""
    if not catalog["groups"] and not catalog["aliases"]:
        return True
    try:
        os.makedirs(LOG_DIR, exist_ok=True)
        fd = os.open(GROUPS + ".lock", os.O_RDWR | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            old = read_json(GROUPS)
            if isinstance(old, dict) and old.get("version") not in (None, 1):
                return False  # do not overwrite a newer catalog format
            merged = load_group_catalog()
            for group_id, info in catalog["groups"].items():
                remember_group(merged, group_id, info["name"], info["ts"])
            if save_aliases:
                merged["aliases"].update(catalog["aliases"])
            if old != merged:
                atomic_write(GROUPS, (json.dumps(merged, allow_nan=False) + "\n").encode())
        return True
    except (OSError, ValueError):
        return False

def session_groups(catalog):
    for path in SESSIONS:
        data = as_dict(read_json(path))
        for window in as_list(data.get("windows")):
            manager = as_dict(as_dict(window).get("tabManager"))
            for group in as_list(manager.get("workspaceGroups")):
                group = as_dict(group)
                remember_group(catalog, group.get("id"), group.get("name"), data.get("createdAt"))

def group_ids(group_id, catalog):
    """Follow recreated identities without trusting cycles in the local cache."""
    seen = set()
    while group_id and group_id not in seen:
        yield group_id
        seen.add(group_id)
        group_id = catalog["aliases"].get(group_id, "")

def group_name(group_id, catalog):
    names = [catalog["groups"][gid] for gid in group_ids(group_id, catalog)
             if gid in catalog["groups"]]
    return max(names, key=lambda n: n["ts"])["name"] if names else ""

def parse_workspace_event(line):
    try:
        ev = json.loads(line)
    except (ValueError, RecursionError):
        return None
    ev = as_dict(ev)
    if (ev.get("category") == "workspace" and as_text(ev.get("id"))
            and as_text(ev.get("workspace_id")) and as_text(ev.get("name"))):
        return ev
    return None

def load_events():
    events, fresh, writable = {}, [], True
    for path in [HISTORY] + ROTATING:
        try:
            with open(path, errors="replace") as f:
                for line in f:
                    ev = parse_workspace_event(line)
                    if ev and ev["id"] not in events:
                        events[ev["id"]] = ev
                        if path != HISTORY:
                            fresh.append(line.rstrip("\n"))
        except FileNotFoundError:
            pass
        except OSError:
            if path == HISTORY:
                writable = False  # cannot deduplicate against unreadable history
    if fresh and writable:
        try:
            os.makedirs(LOG_DIR, exist_ok=True)
            with open(HISTORY, "a") as f:
                f.write("\n".join(fresh) + "\n")
        except OSError:
            pass  # the in-memory events are still usable for this listing
    return events

def iso_to_unix(ts):
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except (ValueError, AttributeError, OverflowError, OSError):
        return 0

def closed_snapshot(snap, wsid, ts, group_name=""):
    if not isinstance(snap, dict) or not finite_number(ts):
        return None
    return {"ts": ts, "id": as_text(wsid) or as_text(snap.get("workspaceId")),
            "cwd": as_text(snap.get("currentDirectory")),
            "branch": as_text(as_dict(snap.get("gitBranch")).get("branch")),
            "title": "", "custom": as_text(snap.get("customTitle")),
            "snapshot": snap, "group_id": as_uuid(snap.get("groupId")),
            "group_name": as_text(group_name)}

def native_closed(catalog=None, notices=None):
    d = read_json(NATIVE)
    out = []
    records = d if isinstance(d, list) else as_dict(d).get("records")
    if not isinstance(records, list) and os.path.exists(NATIVE) and notices is not None:
        notices.append("Could not read native closed-item history; collection is incomplete.")
    for r in as_list(records):
        r = as_dict(r)
        closed_at = r.get("closedAt", 0)
        if not finite_number(closed_at):
            continue
        entry = as_dict(r.get("entry"))
        w = as_dict(entry.get("workspace"))
        inner = as_dict(w.get("_0", w))
        snapshots = [(inner.get("snapshot"), inner.get("workspaceId"), {})] if w else []
        window = as_dict(entry.get("window"))
        window = as_dict(window.get("_0", window))
        manager = as_dict(as_dict(window.get("snapshot")).get("tabManager"))
        names = {}
        for group in as_list(manager.get("workspaceGroups")):
            group = as_dict(group)
            group_id, name = as_uuid(group.get("id")), as_text(group.get("name")).strip()
            if group_id and name:
                names[group_id] = name
                if catalog is not None:
                    remember_group(catalog, group_id, name, closed_at + APPLE_EPOCH)
        window_ids = as_list(window.get("workspaceIds"))
        for i, snap in enumerate(as_list(manager.get("workspaces"))):
            wsid = as_text(as_dict(snap).get("workspaceId"))
            snapshots.append((snap, wsid or (window_ids[i] if i < len(window_ids) else ""), names))
        for snap, wsid, names in snapshots:
            group_id = as_uuid(as_dict(snap).get("groupId"))
            item = closed_snapshot(snap, wsid, closed_at + APPLE_EPOCH, names.get(group_id, ""))
            if item is not None:
                out.append(item)
    return out

def snapshot_key(item):
    return item["id"] or identity(item), item["ts"]

def read_snapshot_archive(f):
    items, digest = {}, hashlib.sha256()
    meta = {"invalid": False, "future": False}
    for line in f:
        digest.update(line.encode("utf-8"))
        try:
            data = as_dict(json.loads(line))
        except (ValueError, RecursionError):
            meta["invalid"] = True
            continue
        if type(data.get("version")) is not int or data["version"] != 1:
            meta["future"] |= type(data.get("version")) is int and data["version"] > 1
            meta["invalid"] = True
            continue
        item = closed_snapshot(data.get("snapshot"), data.get("id"), data.get("ts"),
                               data.get("group_name"))
        if item is not None:
            items[snapshot_key(item)] = item
        else:
            meta["invalid"] = True
    meta["hash"] = digest.hexdigest()
    return items, meta

def atomic_write(path, data):
    """Replace a private file only after its complete contents reach disk."""
    temporary = None
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with tempfile.NamedTemporaryFile(dir=os.path.dirname(path), prefix=".workspace-",
                                         delete=False) as f:
            temporary = f.name  # NamedTemporaryFile creates owner-only files
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temporary, path)
    finally:
        if temporary:
            try:
                os.unlink(temporary)
            except OSError:
                pass

def archive_budget():
    try:
        with open(ARCHIVE_SETTINGS) as f:
            data = json.load(f)
    except FileNotFoundError:
        return ARCHIVE_LIMIT
    if (not isinstance(data, dict) or type(data.get("version")) is not int
            or data["version"] != 1 or type(data.get("budget_mb")) is not int
            or not 1 <= data["budget_mb"] <= 100_000):
        raise ValueError("Invalid archive budget settings")
    return data["budget_mb"] * 1_000_000

def archive_line(item):
    return json.dumps({"version": 1, "id": item["id"], "ts": item["ts"],
                       "snapshot": item["snapshot"], "group_name": item["group_name"]},
                      allow_nan=False, separators=(",", ":")) + "\n"

def checkpoint_info(item):
    """Compare restorable content, ignoring regenerated workspace/panel IDs."""
    if "_checkpoint" in item:
        return item["_checkpoint"]
    snap = item["snapshot"]
    layout = build_layout(snap, bind_sessions=False)
    panels = {as_text(p.get("id")) for p in as_list(snap.get("panels"))
              if isinstance(p, dict) and as_text(p.get("id"))}

    def references(node):
        node = as_dict(node)
        if node.get("type") == "split":
            split = as_dict(node.get("split"))
            return references(split.get("first")) and references(split.get("second"))
        ids = as_list(as_dict(node.get("pane")).get("panelIds"))
        return bool(ids) and all(as_text(pid) in panels for pid in ids)

    try:
        usable = layout is not None and references(snap.get("layout")) and not remote_snapshot(snap)
    except RecursionError:
        usable = False
    t, a, b = restore_counts(snap)
    full = usable and (a > 0 or b > 0 or t > 1)
    # Keep unsupported or remote content distinct; local equivalence describes
    # precisely the layout, sessions, color and group this CLI can restore.
    content = {"layout": layout, "color": snap.get("customColor"),
               "group": item["group_id"], "group_name": item["group_name"]}
    unsupported = any(not isinstance(p, dict) or not any(
        isinstance(p.get(kind), dict) for kind in ("terminal", "browser"))
        for p in as_list(snap.get("panels")))
    if not usable or remote_snapshot(snap) or unsupported:
        content = snap
    encoded = json.dumps(content, sort_keys=True, allow_nan=False).encode("utf-8")
    info = (hashlib.sha256(encoded).hexdigest(), usable, full,
            len(archive_line(item).encode("utf-8")))
    item["_checkpoint"] = info
    return info

def select_checkpoints(items):
    """Latest, usable recovery, and checkpoints spread across days/weeks."""
    unique = {}
    for item in sorted(items, key=lambda it: (it["ts"], it["id"]), reverse=True):
        unique.setdefault(checkpoint_info(item)[0], item)
    ordered = list(unique.values())
    if not ordered:
        return [], set()
    selected, protected = [], set()

    def add(item, protect=False):
        if item is not None:
            key = snapshot_key(item)
            if all(snapshot_key(it) != key for it in selected):
                selected.append(item)
            if protect:
                protected.add(key)

    latest = ordered[0]
    add(latest)
    usable = next((it for it in ordered if checkpoint_info(it)[1]), None)
    add(usable or latest, True)
    # A plain/fallback reopen is indistinguishable from an intentionally bare
    # shell. Conservatively retain the most recent fuller layout in either case.
    if usable is not None and not checkpoint_info(usable)[2]:
        add(next((it for it in ordered if checkpoint_info(it)[2]), None), True)
    for days in (30, 7, 1):
        if len(selected) < ARCHIVE_VERSIONS:
            add(next((it for it in ordered if it["ts"] <= latest["ts"] - days * 86400
                      and it not in selected), None))
    while len(selected) < min(ARCHIVE_VERSIONS, len(ordered)):
        add(max((it for it in ordered if it not in selected),
                key=lambda it: (min(abs(it["ts"] - s["ts"]) for s in selected), it["ts"])))
    return selected, protected

def fit_archive(groups, budget):
    """Drop optional versions first; never evict a protected recovery copy."""
    items, protected = [], set()
    for group in groups.values():
        selected, required = select_checkpoints(group)
        items.extend(selected)
        protected.update(required)
    total = sum(checkpoint_info(it)[3] for it in items)
    optional = sorted((it for it in items if snapshot_key(it) not in protected),
                      key=lambda it: (it["ts"], it["id"]))
    dropped = set()
    for item in optional:
        if total <= budget:
            break
        dropped.add(snapshot_key(item))
        total -= checkpoint_info(item)[3]
    if total > budget:
        return None
    result = {}
    for item in items:
        if snapshot_key(item) not in dropped:
            result.setdefault(identity(item), []).append(item)
    return result

def archive_inventory():
    try:
        with open(SNAPSHOTS, encoding="utf-8", errors="replace") as f:
            return read_snapshot_archive(f)
    except FileNotFoundError:
        return {}, {"hash": hashlib.sha256(b"").hexdigest(), "invalid": False, "future": False}

def closed_history(catalog=None, notices=None, report=None, notify=False):
    """Collect without querying cmux; atomically compact under a stable lock."""
    notices = notices if notices is not None else []
    report = report if report is not None else {}
    report.update(complete=True, blocked=0)
    native, saved = [], {}
    try:
        os.makedirs(LOG_DIR, exist_ok=True)
        fd = os.open(SNAPSHOTS + ".lock", os.O_RDWR | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            report["collected_at"] = datetime.now().timestamp()
            native_notices = []
            native = native_closed(catalog, native_notices)
            if native_notices:
                notices.extend(native_notices)
                report["complete"] = False
            saved, meta = archive_inventory()
            if meta["future"]:
                raise ValueError("Newer archive format")
            budget, groups, valid_saved = archive_budget(), {}, {}
            cutoffs = deletion_cutoffs()
            for item in saved.values():
                if not was_deleted(item, cutoffs):
                    try:
                        checkpoint_info(item)
                    except (ValueError, RecursionError):
                        meta["invalid"] = True
                        continue
                    groups.setdefault(identity(item), []).append(item)
                    valid_saved[snapshot_key(item)] = item
            kept = fit_archive(groups, budget)
            if kept is None:
                report.update(complete=False, blocked=len(native))
                notices.append("Snapshot archive exceeds its budget with protected copies alone; "
                               "collection paused. Increase the archive budget or delete saved workspaces.")
            else:
                for item in sorted(native, key=lambda it: (it["ts"], it["id"])):
                    if was_deleted(item, cutoffs):
                        continue
                    try:
                        checkpoint_info(item)
                    except (ValueError, RecursionError):
                        notices.append("A malformed workspace snapshot could not be archived.")
                        report["complete"] = False
                        continue
                    key = identity(item)
                    prior = valid_saved.get(snapshot_key(item))
                    if (prior is not None and prior["snapshot"] == item["snapshot"]
                            and prior["group_name"] == item["group_name"]
                            and any(snapshot_key(it) == snapshot_key(item) for it in kept.get(key, []))):
                        continue
                    # A revised native record must not erase a usable/full
                    # recovery copy of that very same close.
                    if prior is not None and checkpoint_info(prior)[1:3] > checkpoint_info(item)[1:3]:
                        continue
                    group = [it for it in kept.get(key, []) if snapshot_key(it) != snapshot_key(item)]
                    proposal = dict(kept)
                    if prior is not None and identity(prior) != key:
                        old_key = identity(prior)
                        proposal[old_key] = [it for it in kept.get(old_key, [])
                                             if snapshot_key(it) != snapshot_key(item)]
                    proposal[key] = group + [item]
                    fitted = fit_archive(proposal, budget)
                    if fitted is None:
                        report["blocked"] += 1
                        report["complete"] = False
                    else:
                        kept = fitted
                selected = [it for group in kept.values() for it in group]
                data = "".join(archive_line(it) for it in sorted(
                    selected, key=lambda it: (it["ts"], it["id"]))).encode("utf-8")
                if hashlib.sha256(data).hexdigest() != meta["hash"]:
                    atomic_write(SNAPSHOTS, data)
                saved = {snapshot_key(it): it for it in selected}
                if meta["invalid"]:
                    notices.append("Skipped malformed archive records while compacting readable snapshots.")
                if report["blocked"]:
                    notices.append(f"Snapshot archive is full: {report['blocked']} snapshot(s) could not "
                                   "be saved. Existing recovery copies were kept. Use 'archive budget' "
                                   "or delete saved workspaces to make room.")
                if len(data) >= budget * 0.8:
                    notices.append(f"Snapshot archive is at {len(data) / 1_000_000:.1f} / "
                                   f"{budget / 1_000_000:g} MB (80% capacity warning).")
            report.update(budget_bytes=budget, bytes=os.path.getsize(SNAPSHOTS) if os.path.exists(SNAPSHOTS) else 0,
                          snapshots=len(saved), workspaces=len({identity(it) for it in saved.values()}))
    except (OSError, ValueError, RecursionError):
        report["complete"] = False
        if "collected_at" not in report:
            report["collected_at"] = datetime.now().timestamp()
            native = native_closed(catalog)
        try:
            saved, _ = archive_inventory()
        except OSError:
            pass
        notices.append("Could not save workspace snapshots; existing archive preserved. "
                       "Check archive permissions, format and budget settings.")
    report["notices"] = notices[:10]
    save_archive_status(report, notify)
    notices.extend(note for note in report["notices"] if note not in notices)
    saved.update((snapshot_key(item), item) for item in native)
    if catalog is not None:
        for item in saved.values():
            remember_group(catalog, item["group_id"], item["group_name"], item["ts"])
    return [closed_snapshot(it["snapshot"], it["id"], it["ts"], it["group_name"])
            for it in saved.values()]

def save_archive_status(report, notify=False):
    """Serialize status/notification transitions even when collections overlap."""
    try:
        fd = os.open(ARCHIVE_STATUS + ".lock", os.O_RDWR | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            previous = as_dict(read_json(ARCHIVE_STATUS))
            if (finite_number(previous.get("collected_at")) and
                    previous["collected_at"] > report["collected_at"]):
                return
            for field in ("notification_level", "notification_at"):
                if field in previous:
                    report[field] = previous[field]
            if notify:
                archive_notification(report, previous)
            atomic_write(ARCHIVE_STATUS, (json.dumps(report, allow_nan=False) + "\n").encode())
    except OSError:
        report["complete"] = False
        report["notices"].append("Could not save archive collection status.")

def archive_notification(report, previous):
    """Alert once per capacity/error transition, using fixed, non-private text."""
    level = ("blocked" if not report.get("complete") else
             "warning" if report.get("bytes", 0) >= report.get("budget_bytes", ARCHIVE_LIMIT) * 0.8
             else "ok")
    report["notification_level"] = level
    if level == "ok" or previous.get("notification_level") == level or sys.platform != "darwin":
        return
    message = ("New workspace snapshots could not be saved. Run cmux-ws-manager archive status."
               if level == "blocked" else
               "Workspace snapshot storage is at least 80% full. Run cmux-ws-manager archive status.")
    try:
        subprocess.run(["/usr/bin/osascript", "-e",
                        'display notification ' + json.dumps(message) +
                        ' with title "cmux workspace snapshots"'],
                       capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass  # persistent status and picker notices remain available
    report["notification_at"] = datetime.now().timestamp()

def collect_archive():
    notices, report = [], {}
    catalog = load_group_catalog()
    session_groups(catalog)
    closed_history(catalog, notices, report, notify=True)
    save_group_catalog(catalog, save_aliases=False)
    for notice in report["notices"]:
        print(notice, file=sys.stderr)
    print(f"Snapshot collection: {'complete' if report['complete'] else 'incomplete'}; "
          f"{report.get('snapshots', 0)} saved checkpoint(s).")
    return 0 if report["complete"] else 1

def launchctl(args):
    try:
        result = subprocess.run(["launchctl"] + args, capture_output=True, text=True,
                                errors="replace", timeout=10)
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False

def collector_definition():
    return {"Label": COLLECTOR_LABEL,
            "ProgramArguments": ["/usr/bin/python3", COLLECTOR_SCRIPT, "archive", "collect"],
            "RunAtLoad": True, "WatchPaths": [NATIVE], "StartInterval": 60,
            "ThrottleInterval": 10, "ProcessType": "Background",
            "StandardOutPath": "/dev/null", "StandardErrorPath": "/dev/null"}

def configure_collector(install):
    if sys.platform != "darwin":
        print("The background collector requires macOS launchd.", file=sys.stderr)
        return 1
    service = f"gui/{os.getuid()}/{COLLECTOR_LABEL}"
    previous, previous_script = None, None
    try:
        try:
            with open(COLLECTOR_PLIST, "rb") as f:
                previous = f.read()
            if as_dict(plistlib.loads(previous)).get("Label") != COLLECTOR_LABEL:
                raise ValueError("Unrecognized collector plist")
        except FileNotFoundError:
            pass
        try:
            with open(COLLECTOR_SCRIPT, "rb") as f:
                previous_script = f.read()
        except FileNotFoundError:
            pass
        loaded = launchctl(["print", service])
        if loaded and not launchctl(["bootout", service]):
            raise OSError("Could not stop existing collector")
        if not install:
            if previous is not None:
                os.unlink(COLLECTOR_PLIST)
            if previous_script is not None:
                os.unlink(COLLECTOR_SCRIPT)
            print("Background collection disabled; saved snapshots are kept.")
            return 0
        try:
            # launchd cannot reliably read scripts in privacy-protected folders
            # such as Documents. Install a private copy independent of checkout.
            with open(os.path.realpath(__file__), "rb") as f:
                atomic_write(COLLECTOR_SCRIPT, f.read())
            atomic_write(COLLECTOR_PLIST, plistlib.dumps(collector_definition()))
            if not launchctl(["bootstrap", f"gui/{os.getuid()}", COLLECTOR_PLIST]):
                raise OSError("Could not start collector")
        except OSError:
            if previous_script is not None:
                atomic_write(COLLECTOR_SCRIPT, previous_script)
            else:
                try:
                    os.unlink(COLLECTOR_SCRIPT)
                except FileNotFoundError:
                    pass
            if previous is not None:
                atomic_write(COLLECTOR_PLIST, previous)
                if loaded:
                    launchctl(["bootstrap", f"gui/{os.getuid()}", COLLECTOR_PLIST])
            else:
                try:
                    os.unlink(COLLECTOR_PLIST)
                except FileNotFoundError:
                    pass
            raise
        print("Background collection enabled: history-file changes plus a 60-second check.")
        return collect_archive()
    except (OSError, ValueError, plistlib.InvalidFileException, ExpatError, RecursionError):
        print("Could not configure the collector; check LaunchAgents permissions and launchctl.",
              file=sys.stderr)
        return 1

def collector_state():
    """A loaded job can still fail before Python reaches archive collection."""
    if sys.platform != "darwin":
        return False, None
    try:
        result = subprocess.run(["launchctl", "print", f"gui/{os.getuid()}/{COLLECTOR_LABEL}"],
                                capture_output=True, text=True, errors="replace", timeout=10)
        match = re.search(r"^\s*last exit code = (-?\d+)\s*$", result.stdout, re.MULTILINE)
        return result.returncode == 0, int(match[1]) if match else None
    except (OSError, subprocess.TimeoutExpired):
        return False, None

def archive_status():
    try:
        budget = archive_budget()
        items, meta = archive_inventory()
        size = os.path.getsize(SNAPSHOTS) if os.path.exists(SNAPSHOTS) else 0
    except (OSError, ValueError, RecursionError):
        print("Could not read archive or budget settings.", file=sys.stderr)
        return 1
    print(f"Snapshot archive: {size / 1_000_000:.2f} / {budget / 1_000_000:g} MB "
          f"({size / budget:.1%}); up to {ARCHIVE_VERSIONS} checkpoints per workspace.")
    print(f"Saved: {len(items)} checkpoint(s) across {len({identity(it) for it in items.values()})} workspace(s).")
    enabled, last_exit = collector_state()
    print("Background collector: " + ("enabled" if enabled else "disabled; run 'archive install'."))
    if enabled and last_exit is not None:
        print(f"Last background exit code: {last_exit}" +
              ("; run 'archive install' to repair or refresh the collector." if last_exit else " (success)."))
    report = as_dict(read_json(ARCHIVE_STATUS))
    if finite_number(report.get("collected_at")):
        print("Last collection: " + when_of({"ts": report["collected_at"]}) +
              ("; complete." if report.get("complete") else "; incomplete."))
    else:
        print("Last collection: unknown; run 'archive collect'.")
    for note in as_list(report.get("notices")):
        if as_text(note):
            print(sanitize(note))
    if size >= budget * 0.8:
        print("Capacity warning: increase the budget or delete saved workspaces before storage fills.")
    if meta["future"] or meta["invalid"]:
        print("Some archive records have an unsupported or malformed format.")
    return 1 if (meta["future"] or meta["invalid"] or report.get("complete") is False
                 or (enabled and last_exit)) else 0

def set_archive_budget(mb):
    try:
        os.makedirs(LOG_DIR, exist_ok=True)
        fd = os.open(SNAPSHOTS + ".lock", os.O_RDWR | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            archive_budget()  # never overwrite malformed/unknown settings
            items, meta = archive_inventory()
            if meta["future"] or meta["invalid"]:
                raise ValueError("Unreadable archive records")
            groups, cutoffs = {}, deletion_cutoffs()
            for item in items.values():
                if not was_deleted(item, cutoffs):
                    groups.setdefault(identity(item), []).append(item)
            if fit_archive(groups, mb * 1_000_000) is None:
                print("That budget cannot hold the protected recovery copies. "
                      "Delete selected saved workspaces first or choose a larger budget.", file=sys.stderr)
                return 1
            atomic_write(ARCHIVE_SETTINGS, (json.dumps({"version": 1, "budget_mb": mb}) + "\n").encode())
    except (OSError, ValueError, RecursionError):
        print("Could not change the archive budget; existing settings preserved.", file=sys.stderr)
        return 1
    print(f"Archive budget set to {mb} MB.")
    return collect_archive()

def workspace_checkpoints(item):
    cutoffs = deletion_cutoffs()
    candidates = []
    notices = []
    available = {snapshot_key(entry): entry for entry in closed_history(notices=notices)}
    # Native history wins the normal view. Recovery selection can still access
    # a better archived revision of the same close.
    try:
        saved, _ = archive_inventory()
        for key, entry in saved.items():
            try:
                if key not in available or checkpoint_info(entry)[1:3] > checkpoint_info(available[key])[1:3]:
                    available[key] = entry
            except (ValueError, RecursionError):
                pass
    except OSError:
        pass
    for entry in available.values():
        if identity(entry) == identity(item) and not was_deleted(entry, cutoffs):
            try:
                checkpoint_info(entry)
                candidates.append(entry)
            except (ValueError, RecursionError):
                pass
    for notice in notices:
        print(notice, file=sys.stderr)
    selected, protected = select_checkpoints(candidates)
    selected.sort(key=lambda it: (it["ts"], it["id"]), reverse=True)
    for entry in selected:
        entry["title"] = entry.get("custom") or item["title"]
        entry["protected"] = snapshot_key(entry) in protected
    return selected

def archive_command(args):
    if args == ["collect"]:
        return collect_archive()
    if args == ["status"]:
        return archive_status()
    if args in (["install"], ["uninstall"]):
        return configure_collector(args == ["install"])
    if (len(args) == 2 and args[0] == "budget" and re.fullmatch(r"[0-9]{1,6}", args[1])
            and 1 <= int(args[1]) <= 100_000):
        return set_archive_budget(int(args[1]))
    if (len(args) == 2 and args[0] == "versions" and re.fullmatch(r"[0-9]{1,9}", args[1])
            and int(args[1]) >= 1):
        index, items = int(args[1]), entries()
        if 1 <= index <= len(items):
            checkpoints = workspace_checkpoints(items[index - 1])
            if not checkpoints:
                print("No saved checkpoints for this workspace.")
                return 0
            for i, item in enumerate(checkpoints, 1):
                protected = "  (protected recovery copy)" if item["protected"] else ""
                print(f"{i:>3}  {when_of(item)}  {badges(item)}{protected}")
            print(f"Reopen with: {os.path.basename(sys.argv[0])} reopen {index} --snapshot <n>")
            return 0
    print("usage: cmux-ws-manager archive status|collect|install|uninstall|budget <MB>|versions <n>\n"
          "Try 'cmux-ws-manager --help' for more information.", file=sys.stderr)
    return 1

def resume_command_for(term, bind_sessions=True):
    """Shell text that brings one pane's agent session back, or None.

    Restore selectors identify a binding on the *calling surface*, not a
    global checkpoint. Register a manual binding on the fresh surface first.
    Only known provider argv is reconstructed; history's arbitrary commands,
    environments, approval records, and hook provenance are not replayed.
    """
    term = as_dict(term)
    if remote_terminal(term):
        return None
    for key, id_key in (("resumeBinding", "checkpointId"),
                        ("managedAgentResumeBinding", "checkpointId"),
                        ("agent", "sessionId")):
        agent = as_dict(term.get(key))
        kind, sid = as_text(agent.get("kind")), as_text(agent.get(id_key))
        if kind not in AGENT_RESUME or not sid:
            continue
        # A leading dash could be parsed as a provider option, even when quoted.
        if sid.startswith("-") or any(not c.isprintable() for c in sid):
            return None
        command = " ".join(shlex.quote(a) for a in AGENT_RESUME[kind] + [sid])
        if not bind_sessions:
            return command
        target = '--workspace "$CMUX_WORKSPACE_ID" --surface "$CMUX_SURFACE_ID"'
        selector = f"{shlex.quote(kind)} {shlex.quote(sid)}"
        # Do not retry through a provider after cmux refuses a restore or after
        # the resumed agent exits. execve only replaces the subshell below.
        return (f"cmux surface resume set {target} --kind {shlex.quote(kind)} "
                f"--checkpoint-id {shlex.quote(sid)} -- {command} >/dev/null && "
                f'(cmux restore --surface "$CMUX_SURFACE_ID" {selector})')
    return None

def surface_for(panel, default_cwd, bind_sessions=True):
    panel = as_dict(panel)
    s = {"type": "terminal"}
    name = as_text(panel.get("customTitle"))
    if name:
        s["name"] = name
    browser = panel.get("browser")
    if isinstance(browser, dict):
        s["type"] = "browser"
        url = as_text(browser.get("urlString"))
        if url:
            s["url"] = url
        return s
    term = as_dict(panel.get("terminal"))
    cwd = as_text(term.get("workingDirectory")) or as_text(panel.get("directory")) or default_cwd
    parts = []
    if cwd:
        s["cwd"] = cwd  # start the shell here, including its startup files
        parts.append(f"cd {shlex.quote(cwd)}")
    resume = resume_command_for(term, bind_sessions)
    if resume:
        parts.append(resume)
    if parts:
        s["command"] = " && ".join(parts)
    return s

def build_layout(snapshot, bind_sessions=True):
    """Convert a closed-workspace snapshot into new-workspace --layout JSON.

    Snapshot layout is a binary tree of split/pane nodes; the --layout schema
    wants direction/split/children with per-pane surface lists. Layout surface
    commands are typed into the pane's live shell, so `cd <dir> && <resume>`
    leaves a normal shell behind if (or after) the command exits.
    """
    snapshot = as_dict(snapshot)
    if not isinstance(snapshot.get("layout"), dict):
        return None
    panels = {as_text(p.get("id")): p for p in as_list(snapshot.get("panels"))
              if isinstance(p, dict) and as_text(p.get("id"))}
    default_cwd = as_text(snapshot.get("currentDirectory"))

    def convert(node):
        if not isinstance(node, dict):
            raise ValueError("invalid layout node")
        if node.get("type") == "split":
            sp = as_dict(node.get("split"))
            direction, ratio = sp.get("orientation", "horizontal"), sp.get("dividerPosition", 0.5)
            if direction not in ("horizontal", "vertical"):
                raise ValueError("invalid split direction")
            if type(ratio) not in (int, float) or not 0 < ratio < 1:
                ratio = 0.5
            return {"direction": direction, "split": ratio,
                    "children": [convert(sp.get("first")), convert(sp.get("second"))]}
        if node.get("type") != "pane" or not isinstance(node.get("pane"), dict):
            raise ValueError("invalid pane")
        pane = node["pane"]
        surfaces = [surface_for(panels.get(as_text(pid)), default_cwd, bind_sessions)
                    for pid in as_list(pane.get("panelIds"))]
        return {"pane": {"surfaces": surfaces or [{"type": "terminal"}]}}

    try:
        return convert(snapshot["layout"])
    except (ValueError, RecursionError):
        return None

def agent_panels(snapshot):
    """Indexes of the panels in a snapshot that carry a resumable session."""
    return [i for i, p in enumerate(as_list(as_dict(snapshot).get("panels")))
            if isinstance(p, dict) and p.get("browser") is None
            and resume_command_for(p.get("terminal"))]

def match_panel(donor, idx, panels, taken):
    """Pick the pane in `panels` that corresponds to a donor's agent pane.

    Nothing identifying survives a reopen — panel ids and stableSurfaceIds are
    regenerated — so the match is the pane title plus its working directory,
    then the same position, and only ever a pane with no session of its own.
    """
    wd = as_text(as_dict(donor.get("terminal")).get("workingDirectory")) or None
    title = donor.get("title")

    def free(j):
        p = panels[j]
        return (j not in taken and p.get("browser") is None
                and not resume_command_for(p.get("terminal"))
                and wd == (as_text(as_dict(p.get("terminal")).get("workingDirectory")) or None))

    if title:
        for j, p in enumerate(panels):
            if p.get("title") == title and free(j):
                return j
    if 0 <= idx < len(panels) and free(idx):
        return idx
    return None

def graft_agents(item, donors):
    """Carry an older close's agent bindings onto a newer agent-less snapshot.

    Older versions resumed agents without registering a surface binding, so
    a later close could lose the session. That newer record is the one the
    default view keeps, making the older session unreachable. Donors are earlier
    closes of the same workspace (see `identity`), newest first, so a session
    is never carried over from a different workspace that happens to share the
    directory; the item is left untouched when it has a session of its own or
    nothing matches.
    """
    snap = as_dict(item.get("snapshot"))
    if not as_list(snap.get("panels")) or agent_panels(snap) or remote_snapshot(snap):
        return item
    for donor in donors:
        if not (0 < item["ts"] - donor["ts"] <= GRAFT_WINDOW):
            continue
        dsnap = donor.get("snapshot") or {}
        if remote_snapshot(dsnap):
            continue
        sources = agent_panels(dsnap)
        if not sources:
            continue
        panels, taken, moved = [dict(as_dict(p)) for p in snap["panels"]], set(), 0
        for i in sources:
            dp = dsnap["panels"][i]
            j = match_panel(dp, i, panels, taken)
            if j is None:
                continue
            term = dict(as_dict(panels[j].get("terminal")))
            for key in ("agent", "resumeBinding", "managedAgentResumeBinding"):
                if as_dict(dp.get("terminal")).get(key):
                    term[key] = dp["terminal"][key]
            panels[j]["terminal"] = term
            taken.add(j)
            moved += 1
        if moved:
            item = dict(item, snapshot=dict(snap, panels=panels), grafted=True)
        break  # only the most recent close that had a session gets a say
    return item

def restore_counts(snapshot):
    terms = agents = browsers = 0
    for p in as_list(as_dict(snapshot).get("panels")):
        p = as_dict(p)
        if isinstance(p.get("browser"), dict):
            browsers += 1
        elif resume_command_for(p.get("terminal")):
            agents += 1
        else:
            terms += 1
    return terms, agents, browsers

def norm_path(p):
    return os.path.normpath(os.path.expanduser(p)) if p else ""

def cmux_json(args):
    try:
        result = subprocess.run(["cmux"] + args + ["--json", "--id-format", "uuids"],
                                capture_output=True, text=True, errors="replace", timeout=5,
                                env={**os.environ, "CMUX_QUIET": "1"})
        return json.loads(result.stdout) if result.returncode == 0 else None
    except (OSError, ValueError, RecursionError, subprocess.TimeoutExpired):
        return None

def cmux_windows():
    data = cmux_json(["list-windows"])
    return data if isinstance(data, list) else as_dict(data).get("windows")

def live_groups(windows, methods):
    """Return live groups and whether their absence can be established globally."""
    if "workspace.group.list" not in methods:
        return {}, False
    groups, ambiguous = {}, set()
    complete = bool(as_list(windows))
    # A current-window fallback can recover a known group, but cannot prove
    # that a missing one does not exist in another window.
    for window in as_list(windows) or [None]:
        window = as_dict(window)
        handle = as_uuid(window.get("id")) or as_text(window.get("ref"))
        if as_list(windows) and not re.fullmatch(r"window:[0-9]+|" + UUID_PATTERN, handle):
            complete = False
            continue
        data = as_dict(cmux_json(["workspace-group", "list"] +
                                (["--window", handle] if handle else [])))
        records = data.get("groups")
        owner = as_uuid(data.get("window_id")) or handle
        if not isinstance(records, list) or not owner:
            complete = False
            continue
        for group in records:
            group = as_dict(group)
            group_id = as_uuid(group.get("id"))
            if not group_id:
                complete = False
                continue
            if group_id in groups or group_id in ambiguous:
                complete = False
                ambiguous.add(group_id)
                groups.pop(group_id, None)
                continue
            groups[group_id] = {"id": group_id, "name": as_text(group.get("name")).strip(),
                                "window": owner}
    return groups, complete

def remember_live_groups(catalog, groups):
    now = datetime.now().timestamp()
    for group in groups.values():
        remember_group(catalog, group["id"], group["name"], now)

def open_workspaces(windows=None):
    """Return (ids, cwds, titles) for every open workspace across all windows.

    A reopened directory gets a new workspace UUID, so the id check alone is
    not enough and the directory has to be matched too. `titles` maps a
    directory to the names of the workspaces sitting on it, which is what
    keeps that directory match from swallowing a second, differently named
    workspace on the same path.
    """
    ids, cwds, titles = set(), set(), {}

    def collect(data):
        workspaces = as_dict(data).get("workspaces")
        if not isinstance(workspaces, list):
            return False
        for ws in workspaces:
            ws = as_dict(ws)
            wsid, cwd = as_text(ws.get("id")), as_text(ws.get("current_directory"))
            if wsid:
                ids.add(wsid)
            if cwd:
                d = norm_path(cwd)
                cwds.add(d)
                for key in ("custom_title", "title"):
                    title = as_text(ws.get(key)).strip().casefold()
                    if title:
                        titles.setdefault(d, set()).add(title)
        return True

    if windows is None:
        windows = cmux_windows()
    complete = bool(as_list(windows))
    for win in as_list(windows):
        win = as_dict(win)
        handle = as_text(win.get("id")) or as_text(win.get("ref"))
        if not handle or not collect(cmux_json(["workspace", "list", "--window", handle])):
            complete = False  # keep checking the other windows after one fails
    if complete or collect(cmux_json(["list-workspaces"])):
        return ids, cwds, titles
    try:
        out = subprocess.run(["cmux", "list-workspaces", "--id-format", "uuids"],
                             capture_output=True, text=True, timeout=5,
                             env={**os.environ, "CMUX_QUIET": "1"}).stdout
        ids |= {tok for line in out.splitlines() for tok in line.split() if len(tok) == 36}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return ids, cwds, titles  # this fallback knows no directories or titles

def identity(it):
    """What makes one closed workspace distinct from another.

    cmux hands a reopened workspace a fresh UUID, so an id cannot tell two
    closes of one workspace apart from two workspaces on one directory. A
    title the user set can, and it survives the reopen. The directory
    basename cannot — every close on a directory shares it — so an entry
    with no custom title falls back to the directory alone, as before.
    """
    return (norm_path(it["cwd"]) or it["id"],
            (it.get("custom") or "").strip().casefold())

def event_close(ev):
    p = as_dict(ev.get("payload"))
    title = as_text(p.get("custom_title")) or as_text(p.get("title")) or as_text(p.get("new_title"))
    return {"ts": iso_to_unix(ev.get("occurred_at")), "id": ev["workspace_id"],
            "cwd": as_text(p.get("cwd")), "branch": "", "title": title,
            "custom": as_text(p.get("custom_title"))}

def load_deletions(strict=False):
    """Listing tolerates damage; writes must preserve an existing readable file."""
    empty = {"version": 1, "records": []}
    try:
        with open(DELETIONS) as f:
            data = json.load(f)
    except FileNotFoundError:
        return empty
    except (OSError, ValueError, RecursionError):
        if strict:
            raise ValueError("Unreadable saved removals") from None
        return empty
    if (not isinstance(data, dict) or type(data.get("version")) is not int
            or data["version"] != 1 or not isinstance(data.get("records"), list)):
        if strict:
            raise ValueError("Unsupported saved removals format")
        return empty
    return data

def deletion_cutoffs():
    keys, ids = {}, {}
    for record in load_deletions()["records"]:
        record = as_dict(record)
        key, before = record.get("identity"), record.get("before")
        if (not isinstance(key, list) or len(key) != 2
                or any(not isinstance(v, str) or "\0" in v for v in key)
                or not finite_number(before) or before < 0):
            continue
        key = tuple(key)
        keys[key] = max(keys.get(key, 0), before)
        for wsid in as_list(record.get("ids")):
            wsid = as_text(wsid)
            if wsid:
                ids[wsid] = max(ids.get(wsid, 0), before)
    return keys, ids

def was_deleted(it, cutoffs):
    keys, ids = cutoffs
    return (it["ts"] <= keys.get(identity(it), -math.inf)
            or bool(it["id"] and it["ts"] <= ids.get(it["id"], -math.inf)))

def delete_entry(it):
    """Persist removal metadata only, without editing either source history."""
    temporary = None
    try:
        os.makedirs(LOG_DIR, exist_ok=True)
        # The separate lock remains stable across atomic replacements, so two
        # managers cannot overwrite each other's confirmed removals.
        with open(DELETIONS + ".lock", "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            data = load_deletions(strict=True)
            closes = closed_history() + [event_close(ev) for ev in load_events().values()
                                       if ev["name"] == "workspace.closed"]
            key = identity(it)
            ids = {entry["id"] for entry in closes if identity(entry) == key and entry["id"]}
            if it["id"]:
                ids.add(it["id"])
            matching = [entry for entry in closes
                        if identity(entry) == key or entry["id"] in ids]
            before = max([0, it["ts"]] + [entry["ts"] for entry in matching])
            data["records"].append({"identity": list(key), "ids": sorted(ids), "before": before})
            with tempfile.NamedTemporaryFile(mode="w", dir=LOG_DIR,
                                             prefix=".workspace-deletions-", delete=False) as f:
                temporary = f.name
                json.dump(data, f, allow_nan=False)
                f.write("\n")
                f.flush()
                os.fsync(f.fileno())
            os.replace(temporary, DELETIONS)
        return None
    except (OSError, ValueError, RecursionError) as e:
        return f"Could not save removal ({e.__class__.__name__})."
    finally:
        if temporary:
            try:
                os.unlink(temporary)
            except OSError:
                pass

def dir_occupied(it, open_cwds, open_titles):
    """True when an open workspace already stands in for this closed one.

    Only a workspace on the same directory carrying the same name counts.
    Two workspaces kept on one repo — say a "Group 1" and a "CMUX Stuff" —
    are different workspaces, and closing one of them must not be hidden by
    the other still being open.
    """
    d = norm_path(it["cwd"])
    if d not in open_cwds:
        return False
    custom = (it.get("custom") or "").strip().casefold()
    return not custom or custom in open_titles.get(d, set())

def entries(show_all=False, notices=None):
    titles, ev_closed, created_at = {}, {}, {}
    cutoffs = deletion_cutoffs()
    ordered = sorted(load_events().values(), key=lambda e: (
        iso_to_unix(e.get("occurred_at")), e.get("seq") if type(e.get("seq")) is int else 0))
    for ev in ordered:
        wsid, p = ev["workspace_id"], as_dict(ev.get("payload"))
        title = as_text(p.get("custom_title")) or as_text(p.get("title")) or as_text(p.get("new_title"))
        if title:
            titles[wsid] = title
        ts = iso_to_unix(ev.get("occurred_at"))
        if ev["name"] == "workspace.closed":
            ev_closed[wsid] = event_close(ev)
        elif ev["name"] == "workspace.created":
            ev_closed.pop(wsid, None)  # reopened (e.g. session restore)
            created_at[wsid] = max(created_at.get(wsid, 0), ts)
    catalog = load_group_catalog()
    archive_notices = []
    native = [n for n in closed_history(catalog, archive_notices) if not was_deleted(n, cutoffs)]
    if notices is not None:
        notices.extend(archive_notices)
    else:
        for notice in archive_notices:
            print(notice, file=sys.stderr)
    session_groups(catalog)
    items = [n for n in native if created_at.get(n["id"], 0) <= n["ts"]]
    latest_native = {}
    for item in items:
        latest_native[item["id"]] = max(latest_native.get(item["id"], -math.inf), item["ts"])
    # An archived close must not swallow a later close of the same UUID when
    # the intervening workspace.created event rotated out before we saw it.
    items += [e for e in ev_closed.values()
              if e["ts"] > latest_native.get(e["id"], -math.inf) + CLOSE_EVENT_SLOP
              and not was_deleted(e, cutoffs)]
    windows = cmux_windows()
    open_ids, open_cwds, open_titles = open_workspaces(as_list(windows))
    methods = as_list(as_dict(cmux_json(["capabilities"])).get("methods"))
    groups, _ = live_groups(windows, methods)
    remember_live_groups(catalog, groups)
    save_group_catalog(catalog)
    for it in items:
        if it.get("group_id") and not it["group_name"]:
            it["group_name"] = group_name(it["group_id"], catalog)
    items = [it for it in items if it["id"] not in open_ids]
    if not show_all:
        items = [it for it in items
                 if not dir_occupied(it, open_cwds, open_titles)]
    for it in items:
        if not it["title"]:
            it["title"] = it.get("custom") or titles.get(it["id"]) or \
                os.path.basename(it["cwd"].rstrip("/")) or "(untitled)"
    donors = {}
    if not show_all:  # --all is raw close history; grafting there would lie
        for n in sorted(native, key=lambda x: x["ts"], reverse=True):
            donors.setdefault(identity(n), []).append(n)
    seen, out = set(), []
    for it in sorted(items, key=lambda x: x["ts"], reverse=True):
        key = (it["id"], int(it["ts"]) // 120) if show_all else identity(it)
        if key in seen:
            continue
        seen.add(key)
        if not show_all:
            # donors share the key, so a session is only ever carried between
            # closes of the same workspace, never from its neighbour on the
            # same directory
            it = graft_agents(it, donors.get(key, []))
            it["dir_open"] = norm_path(it["cwd"]) in open_cwds
            try:
                current = checkpoint_info(it)[1:3] if it.get("snapshot") else (False, False)
                it["older_layout"] = any(checkpoint_info(n)[1:3] > current
                                         for n in donors.get(key, []) if n["ts"] < it["ts"])
            except (ValueError, RecursionError):
                pass
        out.append(it)
    return out

def when_of(it):
    try:
        return datetime.fromtimestamp(it["ts"]).strftime("%b %d %H:%M") if it["ts"] else "?"
    except (ValueError, OverflowError, OSError):
        return "?"

def short_cwd(it, home):
    return it["cwd"].replace(home, "~", 1)

def group_label(it):
    if not it.get("group_id"):
        return ""
    name = as_text(it.get("group_name"))
    return "group: " + name if name else "group unknown"

def print_list(items, show_all, prog):
    if not items:
        print("No closed workspaces found.")
        return
    home = os.path.expanduser("~")
    for i, it in enumerate(items, 1):
        branch = f"  [{sanitize(it['branch'])}]" if it["branch"] else ""
        taken = "  (dir open)" if it.get("dir_open") else ""
        group = f"  ({sanitize(group_label(it))})" if group_label(it) else ""
        missing = "  (no usable snapshot)" if build_layout(it.get("snapshot")) is None else ""
        older = "  (older layout saved)" if it.get("older_layout") else ""
        print(f"{i:>3}  {when_of(it):<13} {sanitize(it['title']):<28} "
              f"{sanitize(short_cwd(it, home))}{branch}{taken}{group}{missing}{older}")
    if show_all:
        print("\n(--all view; reopen numbering follows the default filtered list)")
    else:
        print(f"\nReopen one with: {prog} reopen <n>")
        if any(it.get("older_layout") for it in items):
            print(f"Older layouts: {prog} archive versions <n>")

def created_workspace(output):
    match = re.fullmatch(r"OK (workspace:[0-9]+|" + UUID_PATTERN + r")", as_text(output).strip())
    return match[1] if match else ""

def cmux_ok(args):
    try:
        return subprocess.run(
            ["cmux"] + args,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5,
            env={**os.environ, "CMUX_QUIET": "1"}).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False

def restore_color(color, output):
    """Apply a saved color only to the handle returned by workspace creation."""
    handle = created_workspace(output)
    return bool(handle) and cmux_ok(["workspace-action", "--workspace", handle,
                                    "--action", "set-color", "--color", color])

def prepare_group(it, group_id, methods):
    catalog = load_group_catalog()
    session_groups(catalog)
    groups, complete = live_groups(cmux_windows(), methods)
    remember_live_groups(catalog, groups)
    save_group_catalog(catalog)
    target = None
    if "workspace.group.add" in methods:
        target = next((groups[gid] for gid in group_ids(group_id, catalog) if gid in groups), None)
    return {"id": group_id, "name": as_text(it.get("group_name")) or group_name(group_id, catalog),
            "target": target, "complete": complete, "catalog": catalog, "methods": methods}

def restore_group(group, output, cwd):
    """Adopt only the newly created workspace; a group failure never closes it."""
    handle, target = created_workspace(output), group["target"]
    if not handle:
        return False
    if target:
        return cmux_ok(["workspace-group", "add", "--group", target["id"],
                        "--workspace", handle, "--window", target["window"]])
    if (not group["complete"] or not group["name"] or
            "workspace.group.create" not in group["methods"] or
            "workspace.group.add" not in group["methods"]):
        return False
    args = ["workspace-group", "create", "--name", group["name"], "--from", handle]
    if cwd:
        args += ["--cwd", cwd]
    created = as_dict(as_dict(cmux_json(args)).get("group"))
    group_id = as_uuid(created.get("id"))
    if not group_id:
        return False
    catalog = group["catalog"]
    remember_group(catalog, group_id, created.get("name") or group["name"], datetime.now().timestamp())
    catalog["aliases"][group["id"]] = group_id
    if not save_group_catalog(catalog):
        print("Workspace group restored, but its local group mapping could not be saved.", file=sys.stderr)
    return True

def do_reopen(it, plain=False):
    """Rebuild one closed workspace through cmux. Returns cmux's exit code.

    stdin/stderr are inherited; stdout is captured and replayed only when
    needed to target a saved color or group. The browser tears curses down first.
    """
    snapshot = as_dict(it.get("snapshot"))
    if not plain and remote_snapshot(snapshot):
        print("Remote/cloud snapshots require cmux's native History menu; "
              "--plain opens only a local shell.", file=sys.stderr)
        return 1
    cmd = ["cmux", "new-workspace", "--name", it["title"]]
    if it["cwd"]:
        cmd += ["--cwd", it["cwd"]]
    group_id = "" if plain else as_uuid(snapshot.get("groupId"))
    methods = []
    if not plain and (group_id or agent_panels(snapshot)):
        methods = as_list(as_dict(cmux_json(["capabilities"])).get("methods"))
    group = prepare_group(it, group_id, methods) if group_id else None
    if group and group["target"]:
        cmd += ["--window", group["target"]["window"]]
    bind_sessions = all(m in methods for m in ("surface.resume.set", "surface.resume.get"))
    layout = None if plain else build_layout(snapshot, bind_sessions)
    if layout:
        cmd += ["--layout", json.dumps(layout)]
    color = "" if plain else as_text(snapshot.get("customColor"))
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", color):
        color = ""
    capture = bool(color or group)
    try:
        result = subprocess.run(cmd, stdout=subprocess.PIPE if capture else None,
                                text=True, errors="replace", timeout=30,
                                env={**os.environ, "CMUX_QUIET": "1"})
        rc = result.returncode
        if capture:
            print(result.stdout, end="", flush=True)
    except subprocess.TimeoutExpired as error:
        if capture and error.stdout:
            output = error.stdout
            print(output.decode(errors="replace") if isinstance(output, bytes) else output,
                  end="", flush=True)
        print("cmux did not finish within 30 seconds; check for a new workspace "
              "before retrying.", file=sys.stderr)
        return 1
    except OSError:
        print("Could not run cmux; check that its CLI is installed and available on PATH.",
              file=sys.stderr)
        return 1
    if rc == 0 and color and not restore_color(color, result.stdout):
        print("Workspace opened, but its saved color could not be restored.", file=sys.stderr)
    if rc == 0 and group and not restore_group(group, result.stdout, it["cwd"]):
        print("Workspace opened, but its saved group could not be restored.", file=sys.stderr)
    if rc == 0 and layout:
        t, a, b = restore_counts(it["snapshot"])
        print(f"Restored {t} terminal(s), {a} AI session(s) resuming, {b} browser tab(s).")
        if a and it.get("grafted"):
            print("Its AI session came from an earlier close of this directory.")
    elif rc == 0 and not plain:
        print("No usable snapshot for this entry; opened an empty workspace at its directory.")
    return rc

def remote_terminal(term):
    term = as_dict(term)
    return bool(term.get("isRemoteTerminal") or any(
        as_dict(as_dict(term.get(key)).get("launchFlavor")).get("kind") not in (None, "local")
        for key in ("resumeBinding", "managedAgentResumeBinding")))

def remote_snapshot(snapshot):
    snapshot = as_dict(snapshot)
    return bool(snapshot.get("remote") or snapshot.get("cloudVM") or any(
        remote_terminal(as_dict(p).get("terminal"))
        for p in as_list(snapshot.get("panels"))))

# --- interactive browser -------------------------------------------------
#
# One curses screen, one item list, two lines per row. The browser only ever
# picks an entry; main() tears curses down and calls do_reopen, so cmux never
# writes over the screen and the printed summary is identical either way.

MARK_W, NUM_W, WHEN_W = 2, 5, 15  # column widths shared by both row lines

def tui_available():
    """True when a curses UI can safely own this terminal."""
    if curses is None or os.environ.get("TERM", "") in ("", "dumb"):
        return False
    try:  # stdout carries the drawing, stdin the keys; a pipe on either loses
        return sys.stdin.isatty() and sys.stdout.isatty()
    except (ValueError, AttributeError):
        return False

def sanitize(s, ascii_only=False):
    """Strip anything that would move the cursor or reorder a line.

    Titles, paths and group names come from files we treat as untrusted, so tabs,
    newlines, escapes, and bidi overrides all collapse to spaces. On an ASCII
    terminal the rest is transliterated here, because ncurses would otherwise
    silently blank the glyphs it cannot encode and leave the row unreadable.
    """
    s = "".join(c if c.isprintable() else " " for c in (s or ""))
    return s.encode("ascii", "replace").decode() if ascii_only else s

def cwidth(c):
    if unicodedata.combining(c):
        return 0
    return 2 if unicodedata.east_asian_width(c) in "WF" else 1

def dwidth(s):
    return sum(cwidth(c) for c in s)

def fit(s, n, ell="…"):
    """Truncate to n display columns, marking the cut."""
    if n <= 0:
        return ""
    if dwidth(s) <= n:
        return s
    out, w, lim = [], 0, n - dwidth(ell)
    for c in s:
        if w + cwidth(c) > lim:
            break
        out.append(c)
        w += cwidth(c)
    return "".join(out) + ell

def pad(s, n):
    return s + " " * max(0, n - dwidth(s))

def put(win, y, x, s, n, attr=0):
    """addnstr that never raises: the bottom-right cell always errors."""
    if n <= 0 or y < 0 or x < 0 or not s:
        return
    try:
        win.addnstr(y, x, s, n, attr)
    except UnicodeEncodeError:  # one stray glyph must not blank the whole row
        try:
            win.addnstr(y, x, s.encode("ascii", "replace").decode(), n, attr)
        except (curses.error, UnicodeEncodeError):
            pass
    except curses.error:
        pass

def tui_colors():
    """Named attributes, degrading to bold/dim/reverse without color.

    The selection is reverse video in every mode: it inherits the user's
    theme, reads on light and dark backgrounds, and needs no NO_COLOR case.
    """
    names = ("hdr", "num", "time", "title", "path", "meta", "badge", "bar", "warn")
    a = dict.fromkeys(names, 0)
    a["sel"] = curses.A_REVERSE | curses.A_BOLD
    if os.environ.get("NO_COLOR", "") or not curses.has_colors():
        a.update(hdr=curses.A_BOLD, num=curses.A_BOLD, title=curses.A_BOLD,
                 time=curses.A_DIM, meta=curses.A_DIM, badge=curses.A_DIM,
                 bar=curses.A_REVERSE, warn=curses.A_BOLD)
        return a
    try:
        curses.start_color()
    except curses.error:
        return a
    try:
        curses.use_default_colors()  # keep the terminal's own background
        bg = -1
    except curses.error:
        bg = curses.COLOR_BLACK

    def pair(n, fg, back=bg, fallback=0):
        try:
            curses.init_pair(n, fg, back)
            return curses.color_pair(n)
        except (curses.error, ValueError):
            return fallback

    a["hdr"] = pair(1, curses.COLOR_CYAN, fallback=curses.A_BOLD) | curses.A_BOLD
    a["num"] = pair(2, curses.COLOR_YELLOW, fallback=curses.A_BOLD)
    a["time"] = pair(3, curses.COLOR_BLUE, fallback=curses.A_DIM)
    a["title"] = curses.A_BOLD
    a["meta"] = pair(4, curses.COLOR_GREEN, fallback=curses.A_DIM)
    a["badge"] = pair(5, curses.COLOR_MAGENTA, fallback=curses.A_DIM)
    a["warn"] = pair(6, curses.COLOR_RED, fallback=curses.A_BOLD) | curses.A_BOLD
    a["bar"] = pair(7, curses.COLOR_BLACK, curses.COLOR_CYAN,
                    fallback=curses.A_REVERSE)
    return a

def badges(it):
    """What a reopen would restore — counts only, never session identifiers."""
    snap = it.get("snapshot")
    if remote_snapshot(snap):
        parts = ["remote snapshot"]
    elif build_layout(snap) is None:
        parts = ["no snapshot"]
    else:
        t, a, b = restore_counts(snap)
        ai = "AI*" if it.get("grafted") else "AI"  # * = carried over, ? help
        parts = [f"{n}{s}" for n, s in ((t, "T"), (a, ai), (b, "web")) if n]
        parts = parts or ["empty"]
    if it.get("dir_open"):
        parts.append("dir open")
    if it.get("older_layout"):
        parts.append("older layout saved")
    return "  ".join(parts)

def visible(st):
    """The current item list after the incremental filter."""
    items = st["items"] or []
    q = st["q"].casefold()
    if not q:
        return items
    return [it for it in items
            if any(q in (it.get(key) or "").casefold() for key in ("title", "cwd", "group_name"))]

def clamp_view(sel, off, rows, n, margin=1):
    """Clamp the selection into the list and slide the viewport onto it.

    Every frame runs this, so handlers only ever nudge sel; resize, filtering,
    and a shrinking list can never strand the cursor off screen.
    """
    if n <= 0:
        return 0, 0
    sel = max(0, min(sel, n - 1))
    m = margin if rows > 2 * margin + 1 else 0
    if sel < off + m:
        off = sel - m
    elif sel >= off + rows - m:
        off = sel - rows + 1 + m
    return sel, max(0, min(off, max(0, n - rows)))

def draw_row(stdscr, st, y, num, it, selected, w):
    """Two lines: identity on the first, group, branch and restore counts below."""
    a, ell, asc = st["attr"], st["ell"], st["ascii"]
    tw = min(28, max(8, (w - MARK_W - NUM_W - WHEN_W - 2) // 2))  # title and
    cwd_x = MARK_W + NUM_W + WHEN_W + tw + 2              # path split what is left
    rest = max(0, w - cwd_x)
    mark = (st["mark"] + " ") if selected else "  "
    label = f"  {st['dot']}  " if st["show_all"] else f"{num:>3}  "
    when = pad(when_of(it), WHEN_W)
    title = fit(sanitize(it["title"], asc), tw, ell)
    cwd = fit(sanitize(short_cwd(it, st["home"]), asc), rest, ell)
    meta = fit("  ".join(x for x in (sanitize(group_label(it), asc),
                                   sanitize(it["branch"], asc), badges(it)) if x),
               rest, ell)
    if selected:  # one attribute for the whole bar; mixing a color pair with
        put(stdscr, y, 0,     # A_REVERSE is unreadable on many terminals
            pad(mark + label + when + pad(title, tw + 2) + cwd, w), w, a["sel"])
        put(stdscr, y + 1, 0, pad(" " * cwd_x + meta, w), w, a["sel"])
        return
    put(stdscr, y, 0, mark + label, MARK_W + NUM_W, a["num"])
    put(stdscr, y, MARK_W + NUM_W, when, WHEN_W, a["time"])
    put(stdscr, y, MARK_W + NUM_W + WHEN_W, title, tw, a["title"])
    put(stdscr, y, cwd_x, cwd, rest, a["path"])
    put(stdscr, y + 1, cwd_x, meta, rest, a["badge"])

def hint_bar(st, w):
    frags = ([st["up"] + st["down"] + " move", st["enter"] + " reopen",
              "d delete", "s settings", "/ search", "r refresh", "? keys", "q / esc quit"])
    while frags:
        s = "  ".join(frags)
        if dwidth(s) <= w - 2:
            return " " + s
        frags.pop()
    return ""

def tui_draw(stdscr, st):
    if st.get("screen") == "settings":
        return tui_settings_draw(stdscr, st)
    h, w = stdscr.getmaxyx()
    a = st["attr"]
    stdscr.erase()
    if h < 6 or w < 30:
        put(stdscr, 0, 0, "window too small", w - 1, a["warn"])
        stdscr.refresh()
        return
    vis = visible(st)
    rows = max(1, (h - 4) // 2)
    st["rows"] = rows
    st["sel"], st["off"] = clamp_view(st["sel"], st["off"], rows, len(vis))
    total = len(st["items"] or [])
    head = "  Closed workspaces" + (f"  {st['dot']}  all history"
                                     if st["show_all"] else "")
    put(stdscr, 0, 0, fit(head, w - 1, st["ell"]), w - 1, a["hdr"])
    count = f"{len(vis)} of {total}  " if len(vis) != total else f"{total}  "
    if dwidth(head) + dwidth(count) + 2 < w:
        put(stdscr, 0, w - 1 - dwidth(count), count, dwidth(count), a["time"])
    stdscr.hline(1, 0, curses.ACS_HLINE, w)
    if not vis:
        msg = (f"No match for '{sanitize(st['q'], st['ascii'])}'"
               + f" {st['dash']} esc to clear"
               if st["q"] else "No closed workspaces found.")
        put(stdscr, 2 + rows, max(0, (w - dwidth(msg)) // 2), msg, w - 1, a["warn"])
    for i, it in enumerate(vis[st["off"]:st["off"] + rows], st["off"]):
        draw_row(stdscr, st, 2 + (i - st["off"]) * 2, i + 1, it, i == st["sel"], w)
    if st["mode"] == "search":
        put(stdscr, h - 2, 0, fit("/" + sanitize(st["q"], st["ascii"]), w - 1,
                                  st["ell"]), w - 1, a["hdr"])
    elif st["status"]:
        put(stdscr, h - 2, 1, fit(st["status"], w - 2, st["ell"]), w - 2, a["meta"])
    elif st["q"]:
        put(stdscr, h - 2, 1,
            fit(f"filter: {sanitize(st['q'], st['ascii'])}   (esc to clear)",
                w - 2, st["ell"]), w - 2, a["meta"])
    elif st["show_all"]:  # the on-screen twin of the --all footer note
        put(stdscr, h - 2, 1, fit(f"all history {st['dash']} reopen/delete numbering "
                                  "follows the default view", w - 2, st["ell"]),
            w - 2, a["meta"])
    put(stdscr, h - 1, 0, pad(hint_bar(st, w), w), w, a["bar"])
    if st["mode"] == "search":
        try:
            curses.curs_set(1)
            stdscr.move(h - 2, min(w - 1, 1 + dwidth(st["q"])))
        except curses.error:
            pass
    stdscr.refresh()
    if st.get("delete"):
        tui_delete_draw(stdscr, st)

def deletion_description(it, ascii_only=False):
    return ["Workspace: " + sanitize(it["title"], ascii_only),
            "Directory: " + sanitize(short_cwd(it, os.path.expanduser("~")), ascii_only),
            "Remove all existing closes from this tool.",
            "cmux's native History is preserved."]

def deletion_fits(stdscr):
    h, w = stdscr.getmaxyx()
    return h >= 12 and w >= 48

def tui_delete_draw(stdscr, st):
    dialog, a = st["delete"], st["attr"]
    h, w = stdscr.getmaxyx()
    if not deletion_fits(stdscr):
        put(stdscr, h - 2, 0, "Resize terminal to show confirmation.", w - 1, a["warn"])
        stdscr.refresh()
        return
    bh, bw = 12, min(76, w)
    win = curses.newwin(bh, bw, (h - bh) // 2, (w - bw) // 2)
    win.bkgd(" ", a["hdr"])
    win.box()
    put(win, 1, 3, "Are you sure?", bw - 6, a["warn"])
    lines = deletion_description(dialog["item"], st["ascii"])
    for y, line in zip((3, 4, 6, 7), lines):
        put(win, y, 3, fit(line, bw - 6, st["ell"]), bw - 6)
    prompt = "Type YES: "
    put(win, 8, 3, prompt + fit(sanitize(dialog["text"], st["ascii"]),
                              bw - 6 - len(prompt), st["ell"]), bw - 6, a["title"])
    put(win, 9, 3, fit(dialog["error"], bw - 6, st["ell"]), bw - 6, a["warn"])
    put(win, 10, 3, "Enter confirms; Esc / Ctrl+C cancels", bw - 6)
    try:
        curses.curs_set(1)
        win.move(8, min(bw - 4, 3 + len(prompt) + dwidth(dialog["text"])))
    except curses.error:
        pass
    win.refresh()

def tui_delete_key(stdscr, st, k):
    dialog = st["delete"]
    if k in (27, 3):
        st["delete"], st["status"] = None, "Deletion cancelled."
        stdscr.touchwin()
    elif k in (curses.KEY_BACKSPACE, 127, 8):
        dialog["text"], dialog["error"] = dialog["text"][:-1], ""
    elif k == 21:
        dialog["text"], dialog["error"] = "", ""
    elif k in (10, 13, curses.KEY_ENTER):
        if not deletion_fits(stdscr):
            dialog["error"] = "Resize terminal to confirm."
        elif dialog["text"] != "YES":
            dialog["error"] = "Type YES exactly, then press Enter."
        else:
            error = delete_entry(dialog["item"])
            if error:
                dialog["error"] = error
            else:
                sel, off = st["sel"], st["off"]
                st["delete"] = None
                tui_load(stdscr, st)
                st["sel"], st["off"] = clamp_view(sel, off, st["rows"], len(visible(st)))
                st["status"] = "Removed workspace history from this tool."
                stdscr.touchwin()
    elif k == curses.KEY_RESIZE:
        stdscr.erase()
    elif isinstance(k, str) and k.isprintable():
        dialog["text"], dialog["error"] = dialog["text"] + k, ""
    return False

def do_delete(it):
    print("Are you sure?")
    for line in deletion_description(it):
        print(line)
    try:
        while input("Type YES and press Enter (Ctrl+C to cancel): ") != "YES":
            print("Type YES exactly, then press Enter.")
    except (EOFError, KeyboardInterrupt):
        print("\nDeletion cancelled.", file=sys.stderr)
        return 1
    error = delete_entry(it)
    if error:
        print(error, file=sys.stderr)
        return 1
    print("Removed workspace history from this tool.")
    return 0

def tui_load(stdscr, st):
    """Fill the item list, showing a frame first because entries() is slow."""
    st["items"], st["status"] = [], "Loading closed workspaces" + st["ell"]
    tui_draw(stdscr, st)
    try:
        notices = []
        st["items"] = entries(st["show_all"], notices)
        st["status"] = " ".join(notices)
    except Exception as e:  # history is untrusted; never die on one bad file
        st["status"] = f"Could not read history ({e.__class__.__name__})."
    curses.flushinp()  # entries() blocks for seconds; drop keys typed meanwhile
                       # so an impatient enter cannot reopen a random workspace

def settings_visible(view):
    q = view["q"].casefold()
    return [it for it in view["items"] if not q or any(q in text.casefold() for text in
            (it["setting"], setting_value(it), setting_value(it, True), it["source"]))]

def settings_detail_lines(st, width):
    view = st["settings"]
    item = view["detail"]
    if item == "report":
        report = view["report"]
        lines = ["Settings report", "", settings_summary(report),
                 f"Factory baseline: cmux {SETTINGS_VERSION} ({SETTINGS_COMMIT})", "",
                 "Local cmux app settings and configured shortcuts.",
                 "Ghostty configuration and managed device policies are not compared.", ""]
        lines += report["notices"] or ["All available comparisons have verified defaults."]
    else:
        lines = [item["setting"], "", "Current:"]
        lines += json.dumps(item["current"], indent=2, ensure_ascii=False, sort_keys=True).splitlines()
        lines += ["", "Default:"]
        lines += (json.dumps(item["default"], indent=2, ensure_ascii=False, sort_keys=True).splitlines()
                  if item["verified"] else ["(unverified)"])
        lines += ["", "Source: " + item["source"]]
    wrapped = []
    for line in lines:
        line = sanitize(line, st["ascii"])
        if not line:
            wrapped.append("")
        while line:
            chunk = fit(line, max(1, width), "") or line[0]
            wrapped.append(chunk)
            line = line[len(chunk):]
    return wrapped

def tui_settings_draw(stdscr, st):
    view, a = st["settings"], st["attr"]
    h, w = stdscr.getmaxyx()
    stdscr.erase()
    if h < 7 or w < 30:
        put(stdscr, 0, 0, "window too small", max(0, w - 1), a["warn"])
        stdscr.refresh()
        return
    report = view["report"]
    if view["detail"] is not None:
        lines = settings_detail_lines(st, w - 4)
        rows = h - 3
        view["rows"] = rows
        view["detail_off"] = max(0, min(view["detail_off"], max(0, len(lines) - rows)))
        put(stdscr, 0, 1, "Settings details", w - 2, a["hdr"])
        for y, line in enumerate(lines[view["detail_off"]:view["detail_off"] + rows], 1):
            put(stdscr, y, 2, line, w - 4)
        hint = " up/down scroll  pgup/pgdn page  enter / esc back  q quit"
        put(stdscr, h - 1, 0, pad(fit(hint, w, st["ell"]), w), w, a["bar"])
        stdscr.refresh()
        return
    vis = settings_visible(view)
    rows = max(1, (h - 5) // 2)
    view["rows"] = rows
    view["sel"], view["off"] = clamp_view(view["sel"], view["off"], rows, len(vis))
    head = "  Settings differences" + (" (incomplete)" if not report["complete"] and not view["status"] else "")
    put(stdscr, 0, 0, fit(head, w - 1, st["ell"]), w - 1, a["hdr"])
    count = f"{len(vis)} of {len(view['items'])}  "
    if dwidth(head) + dwidth(count) + 2 < w:
        put(stdscr, 0, w - 1 - dwidth(count), count, dwidth(count), a["time"])
    stdscr.hline(1, 0, curses.ACS_HLINE, w)
    key_w = min(48, max(10, (w - 6) // 2))
    value_w = max(4, (w - key_w - 6) // 2)
    def row_text(key, current, default):
        return (pad(fit(key, key_w, st["ell"]), key_w) + "  " +
                pad(fit(current, value_w, st["ell"]), value_w) + "  " +
                fit(default, value_w, st["ell"]))
    put(stdscr, 2, 2, row_text("Setting", "Current", "Default"), w - 3, a["meta"])
    if not vis:
        msg = view["status"] or ("No matching settings." if view["q"] else
               f"No differences among {report['checked']} verified settings." if report["checked"] else
               "No settings could be verified.")
        put(stdscr, 3, 2, fit(msg, w - 4, st["ell"]), w - 4, a["warn"])
    for index, item in enumerate(vis[view["off"]:view["off"] + rows], view["off"]):
        y = 3 + (index - view["off"]) * 2
        selected = index == view["sel"]
        mark = st["mark"] + " " if selected else "  "
        first = mark + row_text(sanitize(item["setting"], st["ascii"]),
                                sanitize(setting_value(item), st["ascii"]),
                                sanitize(setting_value(item, True), st["ascii"]))
        source = "  " + item["source"] + (" (unverified comparison)" if not item["verified"] else "")
        attr = a["sel"] if selected else a["title"]
        put(stdscr, y, 0, pad(fit(first, w, st["ell"]), w), w, attr)
        put(stdscr, y + 1, 0, pad(fit(source, w, st["ell"]), w), w,
            a["sel"] if selected else a["meta"])
    if view["mode"] == "search":
        status, attr = "/" + view["q"], a["hdr"]
    elif report["notices"]:
        status, attr = report["notices"][0] + " (i for report)", a["warn"]
    elif view["q"]:
        status, attr = "filter: " + view["q"] + " (esc to clear)", a["meta"]
    else:
        status, attr = settings_summary(report), a["meta"]
    if view["status"]:
        status = view["status"]
    put(stdscr, h - 2, 1, fit(sanitize(status, st["ascii"]), w - 2, st["ell"]), w - 2, attr)
    frags = ["up/down move", "enter details", "/ search", "r refresh", "i report", "? keys", "esc workspaces", "q quit"]
    while frags and dwidth("  ".join(frags)) > w - 2:
        frags.pop()
    put(stdscr, h - 1, 0, pad(" " + "  ".join(frags), w), w, a["bar"])
    if view["mode"] == "search":
        try:
            curses.curs_set(1)
            stdscr.move(h - 2, min(w - 1, 2 + dwidth(view["q"])))
        except curses.error:
            pass
    stdscr.refresh()

def tui_settings_load(stdscr, st):
    if "settings" not in st:
        st["settings"] = {"items": [], "report": {"complete": False, "checked": 0, "notices": [],
                          "version": "", "changed": 0, "unverified": 0},
                          "sel": 0, "off": 0, "q": "", "mode": "list", "rows": 1,
                          "detail": None, "detail_off": 0, "status": ""}
    view = st["settings"]
    view["detail"], view["status"] = None, "Loading settings" + st["ell"]
    tui_settings_draw(stdscr, st)
    view["report"] = settings_report()
    view["items"], view["status"] = view["report"]["items"], ""
    curses.flushinp()

def tui_settings_key(stdscr, st, k):
    view = st["settings"]
    if view["mode"] == "search":
        return search_key(view, k)
    if k in ("q", 3):
        return True
    if k == "r":
        tui_settings_load(stdscr, st)
        return False
    if k == "?":
        help_overlay(stdscr, st)
        return False
    detail = view["detail"] is not None
    target = "detail_off" if detail else "sel"
    if k in (curses.KEY_UP, "k", 16):
        view[target] -= 1
    elif k in (curses.KEY_DOWN, "j", 14):
        view[target] += 1
    elif k in (curses.KEY_PPAGE, 2):
        view[target] -= view["rows"]
    elif k in (curses.KEY_NPAGE, 6, " "):
        view[target] += view["rows"]
    elif k in (curses.KEY_HOME, "g"):
        view[target] = 0
    elif k in (curses.KEY_END, "G"):
        view[target] = (len(settings_detail_lines(st, max(1, stdscr.getmaxyx()[1] - 4)))
                        if detail else len(settings_visible(view)) - 1)
    elif k == 27:
        if detail:
            view["detail"] = None
        elif view["q"]:
            view["q"] = ""
        else:
            st["screen"] = "workspaces"
    elif k in (10, 13, curses.KEY_ENTER):
        if detail:
            view["detail"] = None
        else:
            vis = settings_visible(view)
            if vis:
                view["detail"] = vis[max(0, min(view["sel"], len(vis) - 1))]
            else:
                view["detail"] = "report"
            view["detail_off"] = 0
    elif k == "/" and not detail:
        view["mode"] = "search"
    elif k == "i":
        view["detail"], view["detail_off"] = "report", 0
    return False

def read_key(win):
    """int for special and control keys, str for typed text, None if interrupted.

    get_wch, not getch: getch hands back raw UTF-8 bytes, which would corrupt
    the search box the moment anyone types a non-ASCII character.
    """
    try:
        k = win.get_wch()
    except curses.error:
        return None
    if isinstance(k, int):
        return k
    return ord(k) if (k == "\x7f" or ord(k) < 32) else k

def search_key(st, k):
    if k == 27:                                    # esc: cancel and drop it
        st["q"], st["mode"] = "", "list"
    elif k in (10, 13, curses.KEY_ENTER):          # accept, keep it as a filter
        st["mode"] = "list"
    elif k in (curses.KEY_BACKSPACE, 127, 8):      # all three genuinely occur
        st["q"] = st["q"][:-1]
    elif k == 21:                                  # ^U
        st["q"] = ""
    elif isinstance(k, str):
        st["q"] += k
    st["sel"] = 0
    return False

def help_overlay(stdscr, st):
    lines = ["up / k        move up", "down / j      move down",
             "pgup pgdn     page", "home g / end G  first / last",
             "enter         reopen with its saved layout",
             "d             delete; type YES and enter to confirm",
             "s             settings differences",
             "/             filter by title, path, or group",
             "esc           clear the filter, quit when none",
             "r             reload",
             "?             this help", "q             quit", "",
             "AI* marks a session carried over from an",
             "earlier close of the same workspace.",
             "dir open means another workspace is already",
             "on that directory; reopening adds a second."]
    if st.get("screen") == "settings":
        lines = ["up / k, down / j  move; scroll in details",
                 "pgup pgdn         page", "home g / end G    first / last",
                 "enter             full setting values / back",
                 "/                 search setting, value, source",
                 "esc               clear filter, then workspaces",
                 "r                 refresh settings only",
                 "i                 version, coverage, and notices",
                 "?                 this help", "q                 quit", "",
                 "Read-only. Unverified defaults are marked.",
                 "Ghostty settings are not compared."]
    h, w = stdscr.getmaxyx()
    bh, bw = min(len(lines) + 4, h), min(max(len(s) for s in lines) + 6, w)
    win = curses.newwin(bh, bw, max(0, (h - bh) // 2), max(0, (w - bw) // 2))
    win.bkgd(" ", st["attr"]["hdr"])
    win.box()
    put(win, 1, 3, "Keys", bw - 4, st["attr"]["hdr"])
    for i, s in enumerate(lines[:bh - 4]):
        put(win, i + 2, 3, s, bw - 4)
    win.refresh()
    read_key(win)
    del win
    stdscr.touchwin()  # without this the covered cells are never repainted

def tui_key(stdscr, st, k):
    """Handle one key. Returns True to leave the loop."""
    if st.get("delete"):
        return tui_delete_key(stdscr, st, k)
    if st.get("screen") == "settings":
        return tui_settings_key(stdscr, st, k)
    if st["mode"] == "search":
        return search_key(st, k)
    vis, rows = visible(st), st["rows"]
    if k in (curses.KEY_UP, "k", 16):
        st["sel"] -= 1
    elif k in (curses.KEY_DOWN, "j", 14):
        st["sel"] += 1
    elif k in (curses.KEY_PPAGE, 2):
        st["sel"] -= rows
    elif k in (curses.KEY_NPAGE, 6, " "):
        st["sel"] += rows
    elif k in (curses.KEY_HOME, "g"):
        st["sel"] = 0
    elif k in (curses.KEY_END, "G"):
        st["sel"] = len(vis) - 1
    elif k == "/":
        st["mode"], st["status"] = "search", ""
    elif k == "d":
        if vis:
            st["delete"] = {"item": dict(vis[max(0, min(st["sel"], len(vis) - 1))]),
                            "text": "", "error": ""}
        else:
            st["status"] = "No closed workspace selected."
    elif k == 27:                       # esc backs out: filter first, then app
        if not st["q"]:
            return True
        st["q"] = ""
    elif k == "r":
        tui_load(stdscr, st)
    elif k == "s":
        st["screen"] = "settings"
        tui_settings_load(stdscr, st)
    elif k == "?":
        help_overlay(stdscr, st)
    elif k in (10, 13, curses.KEY_ENTER):
        if vis:
            st["pick"] = vis[st["sel"]]
            return True
    elif k in ("q", 3):
        return True
    elif k == curses.KEY_RESIZE:
        stdscr.erase()                  # geometry is re-read every frame
    return False

def tui_main(stdscr, st):
    st["started"] = True
    try:
        curses.set_escdelay(25)  # 3.9+; the ESCDELAY env var covers the rest
    except AttributeError:
        pass
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    stdscr.keypad(True)
    st["attr"] = tui_colors()
    try:
        tui_load(stdscr, st)
        while True:
            try:
                tui_draw(stdscr, st)
                k = read_key(stdscr)
            except KeyboardInterrupt:
                if not st.get("delete"):
                    raise
                k = 3  # cbreak terminals deliver Ctrl+C as a signal, not a key
            if k is not None and tui_key(stdscr, st, k):
                return
            view = st["settings"] if st.get("screen") == "settings" else st
            if view["mode"] != "search" and not st.get("delete"):
                try:
                    curses.curs_set(0)
                except curses.error:
                    pass
    finally:
        try:
            curses.curs_set(1)  # endwin does not restore this everywhere
        except curses.error:
            pass

def run_tui(show_all):
    """Run the browser and return its state, or None if curses never started."""
    os.environ.setdefault("ESCDELAY", "25")  # ncurses reads this at initscr
    try:  # LC_CTYPE only: LC_ALL would also set LC_TIME and localize the
        locale.setlocale(locale.LC_CTYPE, "")  # dates in the plain listing
    except locale.Error:
        pass
    try:  # the codeset ncurses will encode with; getpreferredencoding reports
        "…▸↑↓⏎".encode(locale.nl_langinfo(locale.CODESET))  # UTF-8 regardless
        uni = True
    except (UnicodeEncodeError, LookupError, AttributeError, ValueError):
        uni = False
    st = {"items": None, "sel": 0, "off": 0, "rows": 1, "q": "", "mode": "list",
          "status": "", "show_all": show_all, "attr": {}, "pick": None,
          "started": False, "home": os.path.expanduser("~"),
          "ascii": not uni, "ell": "…" if uni else "...",
          "dot": "·" if uni else "-", "dash": "—" if uni else "-",
          "mark": "▸" if uni else ">",
          "up": "↑" if uni else "^", "down": "↓" if uni else "v",
          "enter": "⏎" if uni else "enter"}
    try:
        curses.wrapper(tui_main, st)  # restores the terminal on any exception
    except (curses.error, OSError, ValueError) as e:
        if not st["started"]:
            return None  # never drew anything: the caller prints the plain list
        sys.stderr.write(f"{os.path.basename(sys.argv[0])}: display error "
                         f"({e.__class__.__name__})\n")
    except KeyboardInterrupt:
        st["pick"] = None
    return st

def main():
    prog = os.path.basename(sys.argv[0])
    argv = sys.argv[1:]
    if "-h" in argv or "--help" in argv:
        print(HELP.format(prog=prog), end="")  # short-circuits before any
        return                                 # history read or cmux call
    if argv and argv[0] == "archive":
        return archive_command(argv[1:])
    checkpoint = None
    if "--snapshot" in argv:
        pos = argv.index("--snapshot")
        if (argv.count("--snapshot") != 1 or pos + 1 >= len(argv)
                or not re.fullmatch(r"[0-9]{1,9}", argv[pos + 1])
                or int(argv[pos + 1]) < 1 or "--plain" in argv):
            sys.exit(f"{prog}: --snapshot requires a positive checkpoint number, without --plain.\n"
                     f"Try '{prog} --help' for more information.")
        checkpoint = int(argv[pos + 1])
        argv = argv[:pos] + argv[pos + 2:]
    show_all = "--all" in argv
    plain = "--plain" in argv
    no_tui = "--no-interactive" in argv
    args = [a for a in argv if a not in ("--all", "--plain", "--no-interactive")]
    bad = [a for a in args if a.startswith("-")]
    if bad:
        sys.exit(f"{prog}: unrecognized option: {bad[0]}\n"
                 f"Try '{prog} --help' for more information.")
    if checkpoint is not None and (not args or args[0] != "reopen"):
        sys.exit(f"{prog}: --snapshot requires reopen <n>.\n"
                 f"Try '{prog} --help' for more information.")
    if args and args[0] == "settings":
        if argv != ["settings", "diff"]:
            sys.exit(f"usage: {prog} settings diff\n"
                     f"Try '{prog} --help' for more information.")
        report = settings_report()
        print_settings(report)
        return 0 if report["complete"] else 1
    if args and args[0] == "delete":
        usage = (f"usage: {prog} delete <n>   (run with no args to see numbers)\n"
                 f"Try '{prog} --help' for more information.")
        if len(args) != 2 or plain or no_tui or not re.fullmatch(r"[0-9]+", args[1]):
            sys.exit(usage)
        try:
            index = int(args[1])
        except ValueError:
            sys.exit(usage)
        if index < 1:
            sys.exit(usage)
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            sys.exit(f"{prog}: delete requires an interactive terminal for YES confirmation.\n"
                     f"Try '{prog} --help' for more information.")
        items = entries()  # deletion uses the same numbering as reopen, even with --all
        if index > len(items):
            sys.exit(usage)
        return do_delete(dict(items[index - 1]))
    if args and args[0] == "reopen":
        usage = (f"usage: {prog} reopen <n> [--plain | --snapshot <k>]\n"
                 f"Try '{prog} --help' for more information.")
        if len(args) != 2 or not re.fullmatch(r"[0-9]{1,9}", args[1]) or int(args[1]) < 1:
            sys.exit(usage)
        items = entries()  # reopen indices always refer to the default filtered list
        if int(args[1]) > len(items):
            sys.exit(usage)
        item = items[int(args[1]) - 1]
        if checkpoint is not None:
            checkpoints = workspace_checkpoints(item)
            if checkpoint > len(checkpoints):
                sys.exit(f"{prog}: checkpoint out of range; run archive versions {args[1]}.\n"
                         f"Try '{prog} --help' for more information.")
            item = checkpoints[checkpoint - 1]
        return do_reopen(item, plain)
    if args or plain:
        sys.exit(f"usage: {prog} [--all] [--no-interactive]\n"
                 f"Try '{prog} --help' for more information.")
    if not no_tui and tui_available():
        st = run_tui(show_all)
        if st is not None:  # curses ran, so the list was already loaded once
            if st["pick"]:
                sys.exit(do_reopen(st["pick"]))
            return
    print_list(entries(show_all), show_all, prog)

if __name__ == "__main__":
    sys.exit(main())
